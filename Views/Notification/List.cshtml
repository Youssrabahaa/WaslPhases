@{
    ViewData["Title"] = "الإشعارات";
}

<section class="health-page">
    <div class="page-heading">
        <div>
            <h1>الإشعارات</h1>
            <p>آخر التنبيهات المرتبطة بالحالات والعروض والجلسات</p>
        </div>
    </div>

    <div class="notification-list">
        <article class="notification-item unread">
            <span class="notification-glow"></span>
            <div>
                <strong>تم قبول عرض جديد</strong>
                <p>تم تحويل العرض إلى مطابقة ويمكنك متابعة الجلسات.</p>
            </div>
            <time>منذ 12 دقيقة</time>
        </article>

        <article class="notification-item unread">
            <span class="notification-glow"></span>
            <div>
                <strong>جلسة قادمة</strong>
                <p>الاستشارة الأولية مجدولة يوم الثلاثاء الساعة 05:00 م.</p>
            </div>
            <time>اليوم</time>
        </article>

        <article class="notification-item">
            <span class="notification-glow"></span>
            <div>
                <strong>تقرير قيد المراجعة</strong>
                <p>تم إرسال تقرير الجلسة للمراجعة.</p>
            </div>
            <time>أمس</time>
        </article>
    </div>
</section>
