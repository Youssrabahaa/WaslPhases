@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var isAuthPage = string.Equals(currentController, "Auth", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b8dcc" />
    <title>@ViewData["Title"] - وصل</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/phase_1.styles.css" asp-append-version="true" />
</head>
<body class="@(isAuthPage ? "auth-layout" : "app-layout")">
    @if (isAuthPage)
    {
        <main class="auth-main" role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="wasl-shell">
            @await Html.PartialAsync("_Navbar")
            <main class="wasl-main" role="main">
                <div class="wasl-main-content">
                    @RenderBody()
                </div>
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
