<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - وصل</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/phase_1.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="surface-orb surface-orb-one"></div>
    <div class="surface-orb surface-orb-two"></div>

    @await Html.PartialAsync("_Navbar")

    <div class="container app-shell-main">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="app-toast" role="status">
                <span class="app-toast-dot"></span>
                @statusMessage
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    @await Html.PartialAsync("_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
