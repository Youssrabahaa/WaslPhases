@{
    ViewData["Title"] = "إضافة تقرير";
}

<section class="health-page report-page">
    <div class="page-heading">
        <div>
            <h1>إضافة تقرير</h1>
            <p>اكتب ملخص الجلسة أو الملاحظة المطلوبة للمراجعة</p>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <form class="health-panel form-panel">
                <div class="form-grid">
                    <label class="field-group">
                        <span>نوع التقرير</span>
                        <select class="form-select modern-input" name="targetType">
                            <option>جلسة علاجية</option>
                            <option>سلوك مستخدم</option>
                            <option>مشكلة إدارية</option>
                        </select>
                    </label>

                    <label class="field-group">
                        <span>درجة الأولوية</span>
                        <select class="form-select modern-input" name="priority">
                            <option>عادية</option>
                            <option>متوسطة</option>
                            <option>عاجلة</option>
                        </select>
                    </label>

                    <label class="field-group field-span-2">
                        <span>سبب التقرير</span>
                        <textarea class="form-control modern-input modern-textarea" name="reason" rows="7" placeholder="اكتب ملخصا واضحا لما حدث"></textarea>
                    </label>
                </div>

                <div class="form-actions">
                    <a class="primary-action" asp-controller="Report" asp-action="ViewReport">إرسال التقرير</a>
                    <a class="ghost-action" asp-controller="Session" asp-action="SessionList">الرجوع للجلسات</a>
                </div>
            </form>
        </section>

        <aside class="content-side">
            <article class="health-panel">
                <div class="panel-heading">
                    <h2>بيانات مرتبطة</h2>
                </div>
                <dl class="stacked-list">
                    <div>
                        <dt>الحالة</dt>
                        <dd>حشو أسنان مطلوب</dd>
                    </div>
                    <div>
                        <dt>الجلسة</dt>
                        <dd>الاستشارة الأولية</dd>
                    </div>
                    <div>
                        <dt>المطابقة</dt>
                        <dd>مطابقة نشطة</dd>
                    </div>
                </dl>
            </article>
        </aside>
    </div>
</section>
