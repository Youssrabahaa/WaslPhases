@{
    ViewData["Title"] = "عرض التقرير";
}

<section class="health-page report-page">
    <div class="page-heading">
        <div>
            <h1>تقرير الجلسة</h1>
            <p>تفاصيل التقرير وحالة المراجعة</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Report" asp-action="AddReport">تقرير جديد</a>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>ملخص التقرير</h2>
                        <p>تم إرسال التقرير بعد جلسة الاستشارة الأولية.</p>
                    </div>
                    <span class="status-badge status-pending">قيد المراجعة</span>
                </div>

                <div class="info-grid">
                    <div class="info-block">
                        <span>المبلغ</span>
                        <strong>أحمد الراشد</strong>
                    </div>
                    <div class="info-block">
                        <span>الحالة المرتبطة</span>
                        <strong>حشو أسنان مطلوب</strong>
                    </div>
                    <div class="info-block">
                        <span>نوع التقرير</span>
                        <strong>جلسة علاجية</strong>
                    </div>
                    <div class="info-block">
                        <span>تاريخ الإنشاء</span>
                        <strong>1447/11/4 هـ</strong>
                    </div>
                </div>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <h2>سبب التقرير</h2>
                </div>
                <p class="body-copy">تمت الجلسة الأولى بنجاح، ويحتاج المريض إلى جلسة متابعة بعد أسبوع مع تعليمات وقائية قصيرة.</p>
            </article>
        </section>

        <aside class="content-side">
            <article class="health-panel">
                <div class="panel-heading">
                    <h2>مسار المراجعة</h2>
                </div>
                <div class="timeline-list">
                    <div class="timeline-item">
                        <span class="timeline-dot"></span>
                        <div>
                            <strong>تم إنشاء التقرير</strong>
                            <p>وصل التقرير للمراجعة.</p>
                        </div>
                        <span class="timeline-time">اليوم</span>
                    </div>
                    <div class="timeline-item">
                        <span class="timeline-dot timeline-amber"></span>
                        <div>
                            <strong>بانتظار الإجراء</strong>
                            <p>لم يتم اعتماد التقرير بعد.</p>
                        </div>
                        <span class="timeline-time">قادم</span>
                    </div>
                </div>
            </article>
        </aside>
    </div>
</section>
