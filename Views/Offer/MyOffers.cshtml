@{
    ViewData["Title"] = "عروضي";
}

<section class="health-page">
    <div class="page-heading">
        <div>
            <h1>عروضي</h1>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Offer" asp-action="BrowseCases">تصفح الحالات</a>
        </div>
    </div>

    <section class="filter-panel">
        <label class="field-group">
            <span>تصفية حسب الحالة</span>
            <select class="form-select modern-input">
                <option>كل العروض</option>
                <option>قيد الانتظار</option>
                <option>مقبول</option>
                <option>مرفوض</option>
            </select>
        </label>
        <span class="case-meta">2 عرض</span>
    </section>

    <section class="health-panel">
        <div class="wasl-table-wrap">
            <table class="wasl-table">
                <thead>
                    <tr>
                        <th>عنوان الحالة</th>
                        <th>الفئة</th>
                        <th>السعر (ريال)</th>
                        <th>الجلسات</th>
                        <th>الحالة</th>
                        <th>تاريخ الإرسال</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>تنظيف أسنان وفحص شامل</td>
                        <td>طب الأسنان العام</td>
                        <td>200</td>
                        <td>2</td>
                        <td><span class="status-badge status-pending">قيد الانتظار</span></td>
                        <td>1447/11/4 هـ</td>
                        <td><a class="table-link" asp-controller="Offer" asp-action="OfferDetails">عرض</a></td>
                    </tr>
                    <tr>
                        <td>حشو أسنان مطلوب</td>
                        <td>طب الأسنان الترميمي</td>
                        <td>300</td>
                        <td>1</td>
                        <td><span class="status-badge status-open">مقبول</span></td>
                        <td>1447/11/2 هـ</td>
                        <td><a class="table-link" asp-controller="Match" asp-action="MatchDetails">عرض</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <div class="metric-strip">
        <article class="mini-kpi">
            <span class="metric-icon amber">◷</span>
            <div>
                <span class="mini-kpi-label">العروض قيد الانتظار</span>
                <strong>1</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <span class="metric-icon green">✓</span>
            <div>
                <span class="mini-kpi-label">العروض المقبولة</span>
                <strong>1</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <span class="metric-icon rose">×</span>
            <div>
                <span class="mini-kpi-label">العروض المرفوضة</span>
                <strong>0</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <span class="metric-icon">▤</span>
            <div>
                <span class="mini-kpi-label">إجمالي العروض</span>
                <strong>2</strong>
            </div>
        </article>
    </div>
</section>
