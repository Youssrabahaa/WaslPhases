@{
    ViewData["Title"] = "تقديم عرض";
}

<section class="health-page">
    <div class="page-heading">
        <div>
            <h1>تقديم عرض</h1>
            <p>وضح السعر وعدد الجلسات والرسالة التي ستظهر للمريض</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action" asp-controller="Offer" asp-action="BrowseCases">العودة للحالات</a>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <form class="health-panel form-panel">
                <div class="form-grid">
                    <label class="field-group">
                        <span>السعر المقترح</span>
                        <input class="form-control modern-input" name="proposedPrice" inputmode="decimal" placeholder="200" />
                    </label>

                    <label class="field-group">
                        <span>عدد الجلسات المتوقع</span>
                        <input class="form-control modern-input" name="estimatedSessionsCount" inputmode="numeric" placeholder="2" />
                    </label>

                    <label class="field-group field-span-2">
                        <span>رسالة للمريض</span>
                        <textarea class="form-control modern-input modern-textarea" name="message" rows="6" placeholder="اكتب خطتك المختصرة للمريض"></textarea>
                    </label>
                </div>

                <div class="form-actions">
                    <a class="primary-action" asp-controller="Offer" asp-action="MyOffers">إرسال العرض</a>
                    <a class="ghost-action" asp-controller="Offer" asp-action="BrowseCases">إلغاء</a>
                </div>
            </form>
        </section>

        <aside class="content-side">
            <article class="health-panel">
                <div class="panel-heading">
                    <h2>ملخص الحالة</h2>
                </div>
                <dl class="stacked-list">
                    <div>
                        <dt>العنوان</dt>
                        <dd>تنظيف أسنان وفحص شامل</dd>
                    </div>
                    <div>
                        <dt>الموقع</dt>
                        <dd>الرياض</dd>
                    </div>
                    <div>
                        <dt>العروض الحالية</dt>
                        <dd>3 عروض</dd>
                    </div>
                </dl>
            </article>
        </aside>
    </div>
</section>
