@{
    ViewData["Title"] = "تفاصيل العرض";
    var offerId = ViewData["OfferId"] ?? 1;
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">Offer Details</span>
            <h1 class="health-title">تفاصيل العرض رقم @offerId</h1>
            <p class="health-subtitle">عرض شامل لبيانات العرض، الحالة، ورسالة الطالب قبل قرار المريض.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action" asp-controller="Offer" asp-action="MyOffers">العودة للعروض</a>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>ملخص العرض</h2>
                        <p>بيانات مباشرة من `Offer` model.</p>
                    </div>
                    <span class="status-badge status-pending">قيد المراجعة</span>
                </div>
                <div class="info-grid">
                    <div class="info-block">
                        <span>السعر المقترح</span>
                        <strong>250 ج.م</strong>
                    </div>
                    <div class="info-block">
                        <span>عدد الجلسات</span>
                        <strong>3 جلسات</strong>
                    </div>
                    <div class="info-block">
                        <span>تاريخ الإرسال</span>
                        <strong>28 أبريل 2026</strong>
                    </div>
                    <div class="info-block">
                        <span>الحالة</span>
                        <strong>بانتظار رد المريض</strong>
                    </div>
                </div>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>رسالة الطالب</h2>
                        <p>النص الذي يراه المريض قبل قبول العرض.</p>
                    </div>
                </div>
                <p class="body-copy">أقترح البدء بتقييم داخل العيادة ثم جلستين علاجيتين حسب نتيجة الفحص. سيتم توضيح الخطة للمريض قبل أي إجراء.</p>
            </article>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>قرار العرض</h2>
                        <p>أزرار جاهزة لمسار Match.</p>
                    </div>
                </div>
                <div class="form-actions">
                    <form asp-controller="Match" asp-action="AcceptOffer" asp-route-id="@offerId" method="post" data-loading-form>
                        <button type="submit" class="primary-action loading-button">
                            <span class="button-label">قبول العرض</span>
                            <span class="button-loader"></span>
                        </button>
                    </form>
                    <form asp-controller="Match" asp-action="RejectOffer" asp-route-id="@offerId" method="post">
                        <button type="submit" class="danger-action">رفض العرض</button>
                    </form>
                </div>
            </article>
        </aside>
    </div>
</section>
