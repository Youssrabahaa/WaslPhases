@{
    ViewData["Title"] = "تصفح الحالات";
}

<section class="health-page">
    <div class="page-heading">
        <div>
            <h1>تصفح الحالات</h1>
            <p>ابحث عن حالات علاجية تناسب خبرتك</p>
        </div>
    </div>

    <section class="filter-panel">
        <div class="search-grid">
            <input class="form-control modern-input" placeholder="البحث في الحالات..." />
            <select class="form-select modern-input" aria-label="الفئة">
                <option>كل الفئات</option>
                <option>طب الأسنان العام</option>
                <option>تقويم الأسنان</option>
            </select>
            <select class="form-select modern-input" aria-label="الموقع">
                <option>كل المدن</option>
                <option>الرياض</option>
                <option>جدة</option>
            </select>
            <select class="form-select modern-input" aria-label="الأولوية">
                <option>كل الأولويات</option>
                <option>منخفضة</option>
                <option>متوسطة</option>
            </select>
        </div>
    </section>

    <span class="case-meta">3 حالة متاحة</span>

    <div class="case-list">
        <article class="case-card">
            <div>
                <div class="case-card-top">
                    <span class="status-badge status-draft">أولوية منخفضة</span>
                </div>
                <h3>تنظيف أسنان وفحص شامل</h3>
                <p>أحتاج إلى تنظيف روتيني وفحص شامل للأسنان. لا توجد مشاكل كبيرة، فقط صيانة دورية.</p>
                <div class="row-actions mt-3">
                    <span class="case-meta">طب الأسنان العام</span>
                    <span class="case-meta">الرياض</span>
                    <span class="case-meta">نشرت في 1447/11/3 هـ</span>
                    <span class="case-meta">3 عروض</span>
                </div>
            </div>
            <div class="card-side">
                <a class="primary-action compact-action" asp-controller="Case" asp-action="CaseDetails" asp-route-id="1">عرض التفاصيل</a>
            </div>
        </article>

        <article class="case-card">
            <div>
                <div class="case-card-top">
                    <span class="status-badge status-draft">أولوية منخفضة</span>
                </div>
                <h3>استشارة تقويم أسنان</h3>
                <p>أبحث عن تقييم لتقويم الأسنان وعلاج محتمل بالتقويم.</p>
                <div class="row-actions mt-3">
                    <span class="case-meta">تقويم الأسنان</span>
                    <span class="case-meta">جدة</span>
                    <span class="case-meta">نشرت في 1447/11/1 هـ</span>
                    <span class="case-meta">2 عروض</span>
                </div>
            </div>
            <div class="card-side">
                <a class="primary-action compact-action" asp-controller="Case" asp-action="CaseDetails" asp-route-id="2">عرض التفاصيل</a>
            </div>
        </article>

        <article class="case-card">
            <div>
                <div class="case-card-top">
                    <span class="status-badge status-pending">أولوية متوسطة</span>
                </div>
                <h3>حشو أسنان مطلوب</h3>
                <p>لدي تسوس في الضرس السفلي ويحتاج إلى حشو. أعاني من ألم خفيف.</p>
                <div class="row-actions mt-3">
                    <span class="case-meta">طب الأسنان الترميمي</span>
                    <span class="case-meta">الرياض</span>
                    <span class="case-meta">نشرت في 1447/11/1 هـ</span>
                    <span class="case-meta">5 عروض</span>
                </div>
            </div>
            <div class="card-side">
                <a class="primary-action compact-action" asp-controller="Case" asp-action="CaseDetails" asp-route-id="3">عرض التفاصيل</a>
            </div>
        </article>
    </div>
</section>
