@{
    ViewData["Title"] = "لوحة التحكم";
}

<section class="health-page dashboard-page">
    <div class="page-heading">
        <div>
            <h1>مرحبا، أحمد!</h1>
            <p>ابحث عن الحالات وطور خبرتك السريرية</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Offer" asp-action="BrowseCases">تصفح الحالات</a>
        </div>
    </div>

    <div class="metric-strip">
        <article class="mini-kpi">
            <span class="metric-icon">▤</span>
            <div>
                <span class="mini-kpi-label">الحالات المتاحة</span>
                <strong>3</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <span class="metric-icon">↗</span>
            <div>
                <span class="mini-kpi-label">عروضي</span>
                <strong>2</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <span class="metric-icon amber">◷</span>
            <div>
                <span class="mini-kpi-label">قيد الانتظار</span>
                <strong>1</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <span class="metric-icon green">✓</span>
            <div>
                <span class="mini-kpi-label">المطابقات النشطة</span>
                <strong>1</strong>
            </div>
        </article>
    </div>

    <div class="dashboard-columns">
        <section class="health-panel">
            <div class="panel-heading">
                <h2>الحالات الأخيرة</h2>
                <a class="text-link" asp-controller="Offer" asp-action="BrowseCases">عرض الكل</a>
            </div>

            <div class="case-list">
                <article class="case-list-item">
                    <div>
                        <div class="case-card-top">
                            <span class="status-badge status-draft">منخفضة</span>
                        </div>
                        <h3>تنظيف أسنان وفحص شامل</h3>
                        <p>أحتاج إلى تنظيف روتيني وفحص شامل للأسنان. لا توجد مشاكل كبيرة، فقط صيانة دورية.</p>
                        <div class="row-actions mt-2">
                            <span class="case-meta">طب الأسنان العام</span>
                            <span class="case-meta">الرياض</span>
                            <span class="case-meta">3 عروض</span>
                        </div>
                    </div>
                </article>

                <article class="case-list-item">
                    <div>
                        <div class="case-card-top">
                            <span class="status-badge status-draft">منخفضة</span>
                        </div>
                        <h3>استشارة تقويم أسنان</h3>
                        <p>أبحث عن تقييم لتقويم الأسنان وعلاج محتمل بالتقويم.</p>
                        <div class="row-actions mt-2">
                            <span class="case-meta">تقويم الأسنان</span>
                            <span class="case-meta">جدة</span>
                            <span class="case-meta">2 عروض</span>
                        </div>
                    </div>
                </article>
            </div>
        </section>

        <section class="health-panel">
            <div class="panel-heading">
                <h2>عروضي الأخيرة</h2>
                <a class="text-link" asp-controller="Offer" asp-action="MyOffers">عرض الكل</a>
            </div>

            <div class="case-list">
                <article class="case-list-item">
                    <div>
                        <div class="case-card-top">
                            <span class="status-badge status-pending">قيد الانتظار</span>
                        </div>
                        <h3>تنظيف أسنان وفحص شامل</h3>
                        <div class="row-actions mt-2">
                            <span class="case-meta">200 ريال</span>
                            <span class="case-meta">2 جلسات</span>
                            <span class="case-meta">1447/11/4 هـ</span>
                        </div>
                    </div>
                </article>

                <article class="case-list-item">
                    <div>
                        <div class="case-card-top">
                            <span class="status-badge status-open">مقبول</span>
                        </div>
                        <h3>حشو أسنان مطلوب</h3>
                        <div class="row-actions mt-2">
                            <span class="case-meta">300 ريال</span>
                            <span class="case-meta">1 جلسات</span>
                            <span class="case-meta">1447/11/2 هـ</span>
                        </div>
                    </div>
                </article>
            </div>
        </section>
    </div>
</section>
