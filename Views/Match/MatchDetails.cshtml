@model phase_1.ViewModels.PatientPortal.PatientMatchDetailsViewModel

@{
    ViewData["Title"] = "المطابقة";
}

<section class="health-page">
    <div class="page-heading">
        <div>
            <h1>المطابقة الحالية</h1>
            <p>هذه الصفحة صارت حلقة الوصل بين الحالة والجلسات والتقييم.</p>
        </div>
    </div>

    <article class="health-panel">
        <div class="case-card-top">
            <span class="user-avatar">•</span>
            <div>
                <div class="case-card-top">
                    <span class="status-badge @Model.Match.StatusCssClass">@Model.Match.StatusLabel</span>
                    <h2 class="m-0">@Model.Case.Title</h2>
                </div>
                <span class="case-meta">الطالب: @Model.Match.StudentName</span>
            </div>
        </div>

        <p class="body-copy mt-4">@Model.Case.Description</p>

        <div class="summary-strip mt-4">
            <div class="summary-tile">
                <span>الفئة</span>
                <strong>@Model.Case.Category</strong>
            </div>
            <div class="summary-tile">
                <span>الموقع</span>
                <strong>@Model.Case.Location</strong>
            </div>
            <div class="summary-tile">
                <span>السعر المتفق عليه</span>
                <strong class="text-primary">@Model.Match.AgreedPrice ريال</strong>
            </div>
            <div class="summary-tile">
                <span>الجلسات</span>
                <strong>@Model.Match.SessionsCount</strong>
            </div>
        </div>

        <div class="info-block mt-4">
            <span>رسالة العرض المقبول</span>
            <strong>@Model.Match.OfferMessage</strong>
        </div>

        <div class="form-actions mt-4">
            <a class="primary-action" asp-controller="Session" asp-action="SessionList">عرض الجلسات</a>
            <a class="ghost-action" asp-controller="Review" asp-action="AddReview" asp-route-matchId="@Model.Match.Id">إضافة تقييم</a>
            <a class="ghost-action" asp-controller="Case" asp-action="CaseDetails" asp-route-id="@Model.Case.Id">العودة للحالة</a>
        </div>
    </article>
</section>
