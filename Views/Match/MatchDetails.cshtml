@{
    ViewData["Title"] = "المطابقات";
}

<section class="health-page">
    <div class="page-heading">
        <div>
            <h1>حالتي المطابقة</h1>
            <p>الحالات التي تم قبول عروضك فيها</p>
        </div>
    </div>

    <div class="metric-strip">
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">إجمالي المطابقات</span>
                <strong>1</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">العلاجات النشطة</span>
                <strong class="text-success">1</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">إجمالي الأرباح</span>
                <strong class="text-primary">300 ريال</strong>
            </div>
        </article>
    </div>

    <article class="health-panel">
        <div class="case-card-top">
            <span class="user-avatar">⌾</span>
            <div>
                <div class="case-card-top">
                    <span class="status-badge status-open">مطابقة</span>
                    <h2 class="m-0">حشو أسنان مطلوب</h2>
                </div>
                <span class="case-meta">حالة مريض</span>
            </div>
        </div>

        <p class="body-copy mt-4">لدي تسوس في الضرس السفلي ويحتاج إلى حشو. أعاني من ألم خفيف.</p>

        <div class="summary-strip mt-4">
            <div class="summary-tile">
                <span>الفئة</span>
                <strong>طب الأسنان الترميمي</strong>
            </div>
            <div class="summary-tile">
                <span>الموقع</span>
                <strong>الرياض</strong>
            </div>
            <div class="summary-tile">
                <span>السعر المتفق عليه</span>
                <strong class="text-primary">300 ريال</strong>
            </div>
            <div class="summary-tile">
                <span>الجلسات</span>
                <strong>1</strong>
            </div>
        </div>

        <div class="info-block mt-4">
            <span>رسالة عرضك</span>
            <strong>لدي خبرة في الحشوات المركبة. الإجراء بسيط وخالي من الآلام.</strong>
        </div>

        <div class="form-actions mt-4">
            <a class="primary-action" asp-controller="Session" asp-action="SessionList">عرض الجلسات</a>
            <a class="ghost-action" asp-controller="Offer" asp-action="OfferDetails">تفاصيل العرض</a>
        </div>
    </article>
</section>
