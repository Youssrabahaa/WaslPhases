@model phase_1.ViewModels.PatientPortal.PatientPortalDashboardViewModel

@{
    ViewData["Title"] = "لوحة المريض";
}

<section class="health-page dashboard-page">
    <div class="page-heading">
        <div>
            <h1>مرحبًا بعودتك، @Model.PatientName!</h1>
            <p>تابعي حالاتك، جلساتك، والتقييمات من نفس المسار بدون تنقلات منفصلة.</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Case" asp-action="CreateCase">إنشاء حالة جديدة</a>
            <a class="ghost-action" asp-controller="Patients" asp-action="EditProfile">تعديل الملف</a>
        </div>
    </div>

    <div class="metric-strip">
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">إجمالي الحالات</span>
                <strong>@Model.TotalCases</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">الحالات المفتوحة</span>
                <strong>@Model.OpenCases</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">المطابقات النشطة</span>
                <strong>@Model.ActiveMatches</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">الجلسات القادمة</span>
                <strong>@Model.UpcomingSessions</strong>
            </div>
        </article>
    </div>

    <div class="dashboard-columns">
        <section class="health-panel">
            <div class="panel-heading">
                <h2>الحالات الأخيرة</h2>
                <a class="text-link" asp-controller="Case" asp-action="MyCases">عرض الكل</a>
            </div>
            <div class="case-list">
                @foreach (var patientCase in Model.RecentCases)
                {
                    <article class="case-list-item">
                        <div>
                            <div class="case-card-top">
                                <span class="status-badge @patientCase.StatusCssClass">@patientCase.StatusLabel</span>
                                <span class="status-badge @patientCase.UrgencyCssClass">@patientCase.UrgencyLabel</span>
                            </div>
                            <h3>@patientCase.Title</h3>
                            <p>@patientCase.Description</p>
                            <div class="row-actions mt-2">
                                <span class="case-meta">@patientCase.Category</span>
                                <span class="case-meta">@patientCase.OffersCount عروض</span>
                            </div>
                        </div>
                        <div class="card-side">
                            <a class="ghost-action compact-action" asp-controller="Case" asp-action="CaseDetails" asp-route-id="@patientCase.Id">تفاصيل الحالة</a>
                        </div>
                    </article>
                }
            </div>
        </section>

        <section class="health-panel">
            <div class="panel-heading">
                <h2>الجلسات القادمة</h2>
                <a class="text-link" asp-controller="Session" asp-action="SessionList">إدارة الجلسات</a>
            </div>
            <div class="case-list">
                @foreach (var session in Model.NextSessions)
                {
                    <article class="case-list-item">
                        <div>
                            <span class="status-badge @session.StatusCssClass">@session.StatusLabel</span>
                            <h3>@session.Title</h3>
                            <p>@session.DateLabel</p>
                        </div>
                        <div class="card-side">
                            <a class="ghost-action compact-action" asp-controller="Session" asp-action="SessionDetails" asp-route-id="@session.Id">تفاصيل الجلسة</a>
                        </div>
                    </article>
                }
            </div>
        </section>
    </div>
</section>
