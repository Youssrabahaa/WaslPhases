@{
    ViewData["Title"] = "لوحة المريض";
}

<section class="health-page dashboard-page">
    <div class="page-heading">
        <div>
            <h1>مرحبا بعودتك، سارة!</h1>
            <p>إدارة حالات العلاج والمواعيد الخاصة بك</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Case" asp-action="CreateCase">إنشاء حالة جديدة</a>
        </div>
    </div>

    <div class="metric-strip">
        <article class="mini-kpi">
            <span class="metric-icon">▤</span>
            <div>
                <span class="mini-kpi-label">إجمالي الحالات</span>
                <strong>2</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <span class="metric-icon amber">↗</span>
            <div>
                <span class="mini-kpi-label">الحالات المفتوحة</span>
                <strong>1</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <span class="metric-icon green">□</span>
            <div>
                <span class="mini-kpi-label">المطابقات النشطة</span>
                <strong>1</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <span class="metric-icon">□</span>
            <div>
                <span class="mini-kpi-label">الجلسات القادمة</span>
                <strong>2</strong>
            </div>
        </article>
    </div>

    <div class="dashboard-columns">
        <section class="health-panel">
            <div class="panel-heading">
                <h2>الحالات الأخيرة</h2>
            </div>
            <div class="case-list">
                <article class="case-list-item">
                    <div>
                        <div class="case-card-top">
                            <span class="status-badge status-progress">مفتوحة</span>
                        </div>
                        <h3>تنظيف أسنان وفحص شامل</h3>
                        <p>أحتاج إلى تنظيف روتيني وفحص شامل للأسنان. لا توجد مشاكل كبيرة، فقط صيانة دورية.</p>
                        <div class="row-actions mt-2">
                            <span class="case-meta">طب الأسنان العام</span>
                            <span class="case-meta">3 عروض</span>
                        </div>
                    </div>
                </article>

                <article class="case-list-item">
                    <div>
                        <div class="case-card-top">
                            <span class="status-badge status-open">مطابقة</span>
                        </div>
                        <h3>حشو أسنان مطلوب</h3>
                        <p>لدي تسوس في الضرس السفلي ويحتاج إلى حشو. أعاني من ألم خفيف.</p>
                        <div class="row-actions mt-2">
                            <span class="case-meta">طب الأسنان الترميمي</span>
                            <span class="case-meta">5 عروض</span>
                        </div>
                    </div>
                </article>
            </div>
        </section>

        <section class="health-panel">
            <div class="panel-heading">
                <h2>الجلسات القادمة</h2>
            </div>
            <div class="case-list">
                <article class="case-list-item">
                    <div>
                        <span class="status-badge soft-tag-blue">مجدولة</span>
                        <h3>الاستشارة الأولية</h3>
                        <p>الثلاثاء، 11 ذو القعدة 1447 هـ في 05:00 م</p>
                    </div>
                </article>
                <article class="case-list-item">
                    <div>
                        <span class="status-badge soft-tag-blue">مجدولة</span>
                        <h3>إجراء الحشو</h3>
                        <p>الثلاثاء، 18 ذو القعدة 1447 هـ في 05:00 م</p>
                    </div>
                </article>
            </div>
        </section>
    </div>
</section>
