@model phase_1.ViewModels.PatientPortal.PatientSessionDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل الجلسة";
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">تفاصيل الجلسة</span>
            <h1 class="health-title">جلسة رقم @Model.Session.Number - @Model.Session.Title</h1>
            <p class="health-subtitle">مرتبطة بالحالة "@Model.Case.Title" والطالب @Model.Match.StudentName.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action" asp-controller="Session" asp-action="SessionList">كل الجلسات</a>
            <a class="ghost-action" asp-controller="Case" asp-action="CaseDetails" asp-route-id="@Model.Case.Id">الحالة المرتبطة</a>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>بيانات الجلسة</h2>
                        <p>تفاصيل عملية تساعد على متابعة الموعد والتجهيز له.</p>
                    </div>
                    <span class="status-badge @Model.Session.StatusCssClass">@Model.Session.StatusLabel</span>
                </div>
                <div class="info-grid">
                    <div class="info-block">
                        <span>الموعد</span>
                        <strong>@Model.Session.DateLabel</strong>
                    </div>
                    <div class="info-block">
                        <span>المكان</span>
                        <strong>@Model.Session.Location</strong>
                    </div>
                    <div class="info-block">
                        <span>الغرفة</span>
                        <strong>@Model.Session.Room</strong>
                    </div>
                    <div class="info-block">
                        <span>المشرف</span>
                        <strong>@Model.Session.SupervisorName</strong>
                    </div>
                </div>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>ملاحظات الجلسة</h2>
                    </div>
                </div>
                <p class="body-copy">@Model.Session.Notes</p>
            </article>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>الربط السريع</h2>
                    </div>
                </div>
                <div class="action-list">
                    <a class="action-tile" asp-controller="Match" asp-action="MatchDetails" asp-route-id="@Model.Match.Id">
                        <strong>المطابقة</strong>
                        <span>@Model.Match.StudentName</span>
                    </a>
                    <a class="action-tile" asp-controller="Review" asp-action="ViewReviews">
                        <strong>التقييمات</strong>
                        <span>الانتقال إلى التقييمات المرتبطة بالعلاج.</span>
                    </a>
                </div>
            </article>
        </aside>
    </div>
</section>
