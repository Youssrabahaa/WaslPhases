@model phase_1.ViewModels.PatientPortal.PatientSessionsPageViewModel

@{
    ViewData["Title"] = "الجلسات";
}

<section class="health-page">
    <div class="page-heading">
        <div>
            <h1>الجلسات</h1>
            <p>كل جلسة مرتبطة الآن بالحالة والمطابقة الخاصة بها.</p>
        </div>
    </div>

    <div class="metric-strip">
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">القادمة</span>
                <strong>@Model.UpcomingCount</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">المكتملة</span>
                <strong>@Model.CompletedCount</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">الملغاة</span>
                <strong>@Model.CancelledCount</strong>
            </div>
        </article>
    </div>

    <section class="health-panel">
        <div class="panel-heading">
            <h2>الجدول الزمني للجلسات</h2>
        </div>

        <div class="timeline-list">
            @foreach (var session in Model.Sessions)
            {
                <article class="timeline-entry">
                    <span class="timeline-line">
                        <span class="timeline-icon">•</span>
                    </span>
                    <div class="timeline-card">
                        <span class="timeline-status @session.StatusCssClass">@session.StatusLabel</span>
                        <h3>@session.Title</h3>
                        <time>@session.DateLabel</time>
                        <div class="row-actions">
                            <a class="ghost-action compact-action" asp-controller="Session" asp-action="SessionDetails" asp-route-id="@session.Id">تفاصيل الجلسة</a>
                            <a class="ghost-action compact-action" asp-controller="Case" asp-action="CaseDetails" asp-route-id="@session.CaseId">الحالة المرتبطة</a>
                            @if (session.CanAddReview)
                            {
                                <a class="ghost-action compact-action" asp-controller="Review" asp-action="AddReview" asp-route-matchId="@session.MatchId">إضافة تقييم</a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>
</section>
