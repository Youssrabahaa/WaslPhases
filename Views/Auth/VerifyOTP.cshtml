@{
    ViewData["Title"] = "تأكيد كود التحقق";
    var selectedRole = (ViewData["SelectedRole"] as string) ?? "patient";
    var selectedRoleTitle = (ViewData["SelectedRoleTitle"] as string) ?? "مريض";
    var selectedPortalTitle = (ViewData["SelectedPortalTitle"] as string) ?? "بوابة المريض";
}

<section class="auth-page">
    <article class="auth-card">
        <div class="auth-logo">
            <strong>وصل</strong>
            <span>منصة المطابقة الصحية</span>
        </div>

        <h2>تأكيد رقم الجوال</h2>
        <p>أدخل الكود المرسل لإكمال إنشاء حساب @selectedRoleTitle وفتح @selectedPortalTitle.</p>

        <form class="auth-form-grid">
            <label class="field-group">
                <span>كود التحقق</span>
                <input class="form-control modern-input text-center" name="code" inputmode="numeric" maxlength="6" placeholder="123456" />
            </label>

            <a class="primary-action" asp-controller="Auth" asp-action="EnterPortal" asp-route-role="@selectedRole">تأكيد الكود</a>
        </form>

        <div class="auth-divider"></div>
        <div class="row-actions justify-content-center">
            <a class="text-link" asp-controller="Auth" asp-action="Login" asp-route-role="@selectedRole">تغيير رقم الجوال</a>
            <a class="text-link" href="#">إعادة إرسال الكود</a>
        </div>
    </article>
</section>
