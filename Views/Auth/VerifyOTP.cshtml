@{
    ViewData["Title"] = "تأكيد كود التحقق";
}

<section class="auth-page">
    <article class="auth-card">
        <div class="auth-logo">
            <strong>وصل</strong>
            <span>منصة المطابقة الصحية</span>
        </div>

        <h2>تأكيد رقم الجوال</h2>
        <p>أدخل الكود المرسل إلى رقمك المسجل.</p>

        <form class="auth-form-grid">
            <label class="field-group">
                <span>كود التحقق</span>
                <input class="form-control modern-input text-center" name="code" inputmode="numeric" maxlength="6" placeholder="123456" />
            </label>

            <a class="primary-action" asp-controller="Home" asp-action="Index">تأكيد الكود</a>
        </form>

        <div class="auth-divider"></div>
        <div class="row-actions justify-content-center">
            <a class="text-link" asp-controller="Auth" asp-action="Login">تغيير رقم الجوال</a>
            <a class="text-link" href="#">إعادة إرسال الكود</a>
        </div>
    </article>
</section>
