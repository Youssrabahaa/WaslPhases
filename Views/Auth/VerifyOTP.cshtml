@{
    ViewData["Title"] = "تأكيد كود التحقق";
    var phone = ViewData["Phone"]?.ToString() ?? "01000000000";
}

<section class="auth-page">
    <div class="auth-visual">
        <div class="auth-visual-content">
            <span class="health-kicker">Verify OTP</span>
            <h1>خطوة صغيرة، وأمان أكبر لكل رحلة علاج.</h1>
            <p>هذه الصفحة جاهزة لعرض أخطاء الكود، إعادة الإرسال، وحالة التحميل أثناء التحقق.</p>
        </div>
    </div>

    <article class="auth-card">
        <span class="health-kicker">OTP</span>
        <h2>تأكيد رقم الهاتف</h2>
        <p>أدخل الكود المرسل إلى <strong>@phone</strong>.</p>

        <form asp-controller="Auth" asp-action="VerifyOTP" method="post" class="form-panel" data-loading-form>
            <input type="hidden" name="phone" value="@phone" />
            <div asp-validation-summary="ModelOnly" class="alert-soft-danger"></div>

            <label class="field-group">
                <span>كود التحقق</span>
                <input class="form-control modern-input text-center" name="code" inputmode="numeric" maxlength="6" placeholder="123456" />
                <small class="field-error">حالة خطأ جاهزة: الكود غير صحيح أو انتهت صلاحيته.</small>
            </label>

            <div class="otp-grid" aria-hidden="true">
                <input class="form-control modern-input" value="1" readonly />
                <input class="form-control modern-input" value="2" readonly />
                <input class="form-control modern-input" value="3" readonly />
                <input class="form-control modern-input" value="4" readonly />
            </div>

            <button type="submit" class="primary-action loading-button">
                <span class="button-label">تأكيد الكود</span>
                <span class="button-loader"></span>
            </button>
        </form>

        <div class="row-actions mt-3">
            <a class="text-link" asp-controller="Auth" asp-action="Login">تغيير رقم الهاتف</a>
            <a class="text-link" href="#">إعادة إرسال الكود</a>
        </div>
    </article>
</section>
