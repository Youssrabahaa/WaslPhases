@{
    ViewData["Title"] = "استعادة كلمة المرور";
    var selectedRole = (ViewData["SelectedRole"] as string) ?? "patient";
}

<section class="auth-page">
    <article class="auth-card">
        <div class="auth-logo">
            <strong>وصل</strong>
            <span>منصة المطابقة الصحية</span>
        </div>

        <h2>استعادة كلمة المرور</h2>
        <p>أدخل بريدك الإلكتروني أو رقم الجوال لإرسال كود الاستعادة.</p>

        <form class="auth-form-grid">
            <label class="field-group">
                <span>البريد الإلكتروني أو رقم الجوال</span>
                <input class="form-control modern-input" name="account" placeholder="example@email.com" />
            </label>

            <a class="primary-action" asp-controller="Auth" asp-action="ResetPassword" asp-route-role="@selectedRole">إرسال الكود</a>
        </form>

        <div class="auth-divider"></div>
        <a class="text-link d-block text-center" asp-controller="Auth" asp-action="Login" asp-route-role="@selectedRole">العودة لتسجيل الدخول</a>
    </article>
</section>
