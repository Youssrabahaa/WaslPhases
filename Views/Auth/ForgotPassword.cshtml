@{
    ViewData["Title"] = "استعادة كلمة المرور";
}

<section class="auth-page">
    <div class="auth-visual">
        <div class="auth-visual-content">
            <span class="health-kicker">استعادة الحساب</span>
            <h1>استرجاع هادئ من غير تعقيد.</h1>
            <p>يدخل المستخدم رقم الهاتف، ثم ينتقل إلى شاشة إعادة التعيين بالكود الجديد.</p>
        </div>
    </div>

    <article class="auth-card">
        <span class="health-kicker">Recovery</span>
        <h2>استعادة كلمة المرور</h2>
        <p>سنرسل كود إعادة تعيين على رقم الهاتف المسجل.</p>

        <form class="form-panel">
            <label class="field-group">
                <span>رقم الهاتف</span>
                <input class="form-control modern-input" name="phone" inputmode="tel" placeholder="01012345678" />
            </label>
            <a class="primary-action loading-button" asp-controller="Auth" asp-action="ResetPassword">
                <span class="button-label">إرسال كود الاستعادة</span>
                <span class="button-loader"></span>
            </a>
        </form>

        <a class="text-link d-inline-block mt-3" asp-controller="Auth" asp-action="Login">العودة لتسجيل الدخول</a>
    </article>
</section>
