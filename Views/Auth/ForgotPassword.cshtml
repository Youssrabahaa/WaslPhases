@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إعادة تعيين كلمة المرور - وصل</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/forgetPassword.css">
</head>
<body>
    <div class="container">
        <div class="card">
            <div class="card-header">
                <div class="logo-section">
                    <h1 class="logo-title">وصل</h1>
                    <p class="logo-subtitle">منصة المطابقة الصحية</p>
                </div>
                <h2 class="page-title">إعادة تعيين كلمة المرور</h2>
            </div>

            <form asp-action="ForgotPassword" method="post" id="resetPasswordForm" class="form-content">
                <p class="description">
                    أدخل بريدك الإلكتروني وسنرسل لك رمز التحقق لإعادة تعيين كلمة المرور
                </p>

                <div class="form-group">
                    <label for="emailInput" class="form-label">البريد الإلكتروني</label>
                    <input type="email"
                           name="email"
                           id="emailInput"
                           class="form-input"
                           placeholder="أدخل البريد الإلكتروني"
                           required>
                    <span class="error-message" id="emailError"></span>
                </div>

                <button type="submit" class="submit-btn" id="submitBtn">
                    <span class="btn-text">إرسال رمز التحقق</span>
                </button>

                <div class="divider"></div>

                <div class="back-link-container">
                    <a asp-action="Login" class="back-link" style="text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <span>العودة لتسجيل الدخول</span>
                        <svg class="back-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7.99996 12.6667L12.6666 8.00004L7.99996 3.33337" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M3.33329 8H12.6666" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="toast" id="successToast">
        <span id="toastMessage"></span>
    </div>

    <script src="~/js/forgetPassword.js"></script>
</body>
</html>
