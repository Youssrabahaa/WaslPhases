@{
    ViewData["Title"] = "تسجيل الدخول";
}

<section class="auth-page">
    <article class="auth-card">
        <div class="auth-logo">
            <strong>وصل</strong>
            <span>منصة المطابقة الصحية</span>
        </div>

        <h2>مرحبا بعودتك</h2>

        <form class="auth-form-grid">
            <label class="field-group">
                <span>البريد الإلكتروني</span>
                <input class="form-control modern-input" name="email" type="email" placeholder="example@email.com" />
            </label>

            <label class="field-group">
                <span>كلمة المرور</span>
                <input class="form-control modern-input" name="password" type="password" placeholder="أدخل كلمة المرور" />
            </label>

            <a class="text-link d-inline-block" asp-controller="Auth" asp-action="ForgotPassword">نسيت كلمة المرور؟</a>

            <a class="primary-action" asp-controller="Home" asp-action="Index">تسجيل الدخول</a>
        </form>

        <div class="auth-divider"></div>
        <a class="text-link d-block text-center" asp-controller="Auth" asp-action="SelectRole">ليس لديك حساب؟ سجل الآن</a>
    </article>
</section>
