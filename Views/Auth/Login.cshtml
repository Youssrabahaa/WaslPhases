@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول - وصل</title>
    
    <link rel="stylesheet" href="~/css/login.css">
</head>
<body>

    <div class="login-container">
        <div class="card">
            <div class="card-header">
                <div class="logo-section">
                    <h1 class="logo-title">وصل</h1>
                    <p class="logo-subtitle">منصة المطابقة الصحية</p>
                </div>
                <h2 class="card-title">مرحباً بعودتك</h2>
            </div>

            <form asp-action="Login" method="post" class="form-section">
                
                <div class="form-group">
                    <label class="form-label">البريد الإلكتروني</label>
                    <input type="email" name="email" class="form-input" placeholder="أدخل البريد الإلكتروني" id="emailInput" required>
                </div>

                <div class="form-group">
                    <label class="form-label">كلمة المرور</label>
                    <input type="password" name="password" class="form-input" placeholder="أدخل كلمة المرور" id="passwordInput" required>
                </div>

                <div class="forgot-password-container">
                    <a asp-action="ForgotPassword" asp-controller="Auth" class="forgot-password-link">نسيت كلمة المرور؟</a>
                </div>

                <button type="submit" class="login-button" id="loginBtn">تسجيل الدخول</button>

                <div class="signup-container">
                    <span class="signup-text">ليس لديك حساب؟ </span>
                    <a asp-action="SelectRole" asp-controller="Auth" class="signup-link">سجل الآن</a>
                </div>
            </form>
        </div>
    </div>

    <script src="~/js/login.js"></script>
</body>
</html>