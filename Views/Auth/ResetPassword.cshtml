@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
    var phone = ViewData["Phone"]?.ToString() ?? "01000000000";
}

<section class="auth-page">
    <div class="auth-visual">
        <div class="auth-visual-content">
            <span class="health-kicker">Reset Password</span>
            <h1>كلمة مرور جديدة، ونهاية flow واضحة.</h1>
            <p>الصفحة تعرض التحقق من الكود وكلمة المرور الجديدة مع نفس لغة التصميم المستخدمة في باقي النظام.</p>
        </div>
    </div>

    <article class="auth-card">
        <span class="health-kicker">New Password</span>
        <h2>إعادة التعيين</h2>
        <p>أدخل الكود المرسل إلى <strong>@phone</strong> ثم كلمة المرور الجديدة.</p>

        <form asp-controller="Auth" asp-action="ResetPassword" method="post" class="form-panel" data-loading-form>
            <input type="hidden" name="phone" value="@phone" />
            <div asp-validation-summary="ModelOnly" class="alert-soft-danger"></div>

            <label class="field-group">
                <span>كود التحقق</span>
                <input class="form-control modern-input" name="code" inputmode="numeric" placeholder="123456" />
            </label>
            <label class="field-group">
                <span>كلمة المرور الجديدة</span>
                <input class="form-control modern-input" type="password" name="password" placeholder="••••••••" />
            </label>
            <label class="field-group">
                <span>تأكيد كلمة المرور</span>
                <input class="form-control modern-input" type="password" name="confirmPassword" placeholder="••••••••" />
            </label>

            <button type="submit" class="primary-action loading-button">
                <span class="button-label">تحديث كلمة المرور</span>
                <span class="button-loader"></span>
            </button>
        </form>
    </article>
</section>
