@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
    var selectedRole = (ViewData["SelectedRole"] as string) ?? "patient";
}

<section class="auth-page">
    <article class="auth-card">
        <div class="auth-logo">
            <strong>وصل</strong>
            <span>منصة المطابقة الصحية</span>
        </div>

        <h2>إعادة تعيين كلمة المرور</h2>

        <form class="auth-form-grid">
            <label class="field-group">
                <span>كود التحقق</span>
                <input class="form-control modern-input" name="code" inputmode="numeric" placeholder="123456" />
            </label>

            <label class="field-group">
                <span>كلمة المرور الجديدة</span>
                <input class="form-control modern-input" name="password" type="password" placeholder="أدخل كلمة المرور الجديدة" />
            </label>

            <label class="field-group">
                <span>تأكيد كلمة المرور</span>
                <input class="form-control modern-input" name="confirmPassword" type="password" placeholder="أعد كتابة كلمة المرور" />
            </label>

            <a class="primary-action" asp-controller="Auth" asp-action="Login" asp-route-role="@selectedRole">تحديث كلمة المرور</a>
        </form>
    </article>
</section>
