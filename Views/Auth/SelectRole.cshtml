@{
    ViewData["Title"] = "اختيار نوع الحساب";
}

<section class="auth-page">
    <article class="auth-card">
        <div class="auth-logo">
            <strong>وصل</strong>
            <span>منصة المطابقة الصحية</span>
        </div>

        <h2>إنشاء حساب جديد</h2>
        <p class="text-center">اختر دورك للبدء</p>

        <div class="auth-role-grid">
            <a class="role-card" asp-controller="Auth" asp-action="Register" asp-route-role="patient">
                <span class="role-icon">⌾</span>
                <h2>مريض</h2>
                <p>أبحث عن علاج أسنان من العيادات التدريبية</p>
            </a>

            <a class="role-card" asp-controller="Auth" asp-action="Register" asp-route-role="student">
                <span class="role-icon">▱</span>
                <h2>طالب طب أسنان</h2>
                <p>طالب طب أسنان يقدم خدمات علاجية</p>
            </a>
        </div>

        <a class="text-link d-block text-center mt-4" asp-controller="Auth" asp-action="Login" asp-route-role="patient">لديك حساب؟ سجل دخولك</a>
    </article>
</section>
