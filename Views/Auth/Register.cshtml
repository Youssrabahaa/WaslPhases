@{
    ViewData["Title"] = "إنشاء حساب";
    var selectedRole = (ViewData["SelectedRole"] as string) ?? "patient";
    var selectedRoleTitle = (ViewData["SelectedRoleTitle"] as string) ?? "مريض";
    var selectedPortalTitle = (ViewData["SelectedPortalTitle"] as string) ?? "بوابة المريض";
    var isPatient = selectedRole == "patient";
}

<section class="auth-page">
    <article class="auth-card">
        <div class="auth-logo">
            <strong>وصل</strong>
            <span>منصة الربط الطبي</span>
        </div>

        <h2>إنشاء حساب @selectedRoleTitle</h2>

        <div class="auth-segment">
            <a class="@(isPatient ? "active" : null)" asp-controller="Auth" asp-action="Register" asp-route-role="patient">مريض</a>
            <a class="@(!isPatient ? "active" : null)" asp-controller="Auth" asp-action="Register" asp-route-role="student">طالب طب أسنان</a>
        </div>

        <p class="text-center">بعد التحقق، هنفتح لك @selectedPortalTitle مباشرة.</p>

        <form class="auth-form-grid">
            <label class="field-group">
                <span>الاسم الكامل</span>
                <input class="form-control modern-input" name="fullName" placeholder="أدخل اسمك الكامل" />
            </label>

            <label class="field-group">
                <span>رقم الجوال</span>
                <input class="form-control modern-input" name="phone" inputmode="tel" placeholder="+٠ ١٢٣ ٤٥٦ ٧٨٩" />
            </label>

            <label class="field-group">
                <span>البريد الإلكتروني</span>
                <input class="form-control modern-input" name="email" type="email" placeholder="email@example.com" />
            </label>

            <div class="auth-actions">
                <a class="primary-action" asp-controller="Auth" asp-action="VerifyOTP" asp-route-role="@selectedRole">إنشاء الحساب</a>
                <a class="ghost-action" asp-controller="Auth" asp-action="SelectRole">رجوع</a>
            </div>
        </form>
    </article>
</section>
