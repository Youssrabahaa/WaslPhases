@{
    ViewData["Title"] = "إنشاء حساب";
}

<section class="auth-page">
    <article class="auth-card">
        <div class="auth-logo">
            <strong>وصل</strong>
            <span>منصة الربط الطبي</span>
        </div>

        <h2>إنشاء حساب جديد</h2>

        <div class="auth-segment">
            <span class="active">التسجيل ك مريض</span>
            <a asp-controller="Auth" asp-action="SelectRole">تغيير الدور</a>
        </div>

        <form class="auth-form-grid">
            <label class="field-group">
                <span>الاسم الكامل</span>
                <input class="form-control modern-input" name="fullName" placeholder="أدخل اسمك الكامل" />
            </label>

            <label class="field-group">
                <span>رقم الجوال</span>
                <input class="form-control modern-input" name="phone" inputmode="tel" placeholder="+٠ ١٢٣ ٤٥٦ ٧٨٩" />
            </label>

            <label class="field-group">
                <span>البريد الإلكتروني</span>
                <input class="form-control modern-input" name="email" type="email" placeholder="email@example.com" />
            </label>

            <div class="auth-actions">
                <a class="primary-action" asp-controller="Auth" asp-action="VerifyOTP">إنشاء الحساب</a>
                <a class="ghost-action" asp-controller="Auth" asp-action="SelectRole">رجوع</a>
            </div>
        </form>
    </article>
</section>
