@{
    ViewData["Title"] = "إضافة تقييم";
}

<section class="health-page">
    <div class="page-heading">
        <div>
            <h1>كتابة تقييم</h1>
            <p>سجل تقييمك بعد اكتمال الخدمة</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action" asp-controller="Review" asp-action="ViewReviews">عرض التقييمات</a>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <form class="health-panel form-panel">
                <label class="field-group">
                    <span>التقييم</span>
                    <select class="form-select modern-input" name="rating">
                        <option value="5">5 نجوم - ممتاز</option>
                        <option value="4">4 نجوم - جيد جدا</option>
                        <option value="3">3 نجوم - جيد</option>
                        <option value="2">2 نجوم - يحتاج تحسين</option>
                        <option value="1">1 نجمة - تجربة ضعيفة</option>
                    </select>
                </label>

                <div class="rating-row" aria-hidden="true">
                    <span class="star">★</span>
                    <span class="star">★</span>
                    <span class="star">★</span>
                    <span class="star">★</span>
                    <span class="star">★</span>
                </div>

                <label class="field-group">
                    <span>تعليق اختياري</span>
                    <textarea class="form-control modern-input modern-textarea" name="comment" rows="6" placeholder="اكتب ملاحظتك"></textarea>
                </label>

                <a class="primary-action" asp-controller="Review" asp-action="ViewReviews">حفظ التقييم</a>
            </form>
        </section>

        <aside class="content-side">
            <article class="health-panel">
                <div class="panel-heading">
                    <h2>الخدمة المرتبطة</h2>
                </div>
                <dl class="stacked-list">
                    <div>
                        <dt>الحالة</dt>
                        <dd>حشو أسنان مطلوب</dd>
                    </div>
                    <div>
                        <dt>الطالب</dt>
                        <dd>أحمد الراشد</dd>
                    </div>
                </dl>
            </article>
        </aside>
    </div>
</section>
