@model phase_1.ViewModels.PatientPortal.PatientReviewsPageViewModel

@{
    ViewData["Title"] = "التقييمات";
}

<section class="health-page">
    <div class="page-heading">
        <div>
            <h1>التقييمات</h1>
            <p>صفحة التقييمات مرتبطة الآن بالمطابقة نفسها، ويمكن الوصول إليها من الجلسات والحالات.</p>
        </div>
        <div class="hero-actions">
            @if (Model.PendingReview is not null)
            {
                <a class="primary-action" asp-controller="Review" asp-action="AddReview" asp-route-matchId="@Model.PendingReview.MatchId">كتابة تقييم</a>
            }
        </div>
    </div>

    <div class="metric-strip">
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">متوسط التقييم</span>
                <strong><span class="star">★</span> @Model.AverageRating.ToString("0.0")</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">التقييمات المستلمة</span>
                <strong>@Model.ReceivedCount</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">التقييمات المقدمة</span>
                <strong>@Model.SubmittedCount</strong>
            </div>
        </article>
    </div>

    <div class="dashboard-columns">
        <section class="health-panel">
            <div class="panel-heading">
                <h2>التقييمات المستلمة</h2>
            </div>
            @foreach (var review in Model.ReceivedReviews)
            {
                <article class="review-card">
                    <div class="case-card-top">
                        <span class="user-avatar">•</span>
                        <div>
                            <h3>@review.StudentName</h3>
                            <span class="case-meta">@review.AuthorRoleLabel</span>
                        </div>
                    </div>
                    <div class="rating-row">
                        @for (var i = 0; i < review.Rating; i++)
                        {
                            <span class="star">★</span>
                        }
                    </div>
                    <p>@review.Comment</p>
                    <div class="row-actions">
                        <a class="status-badge status-draft" asp-controller="Case" asp-action="CaseDetails" asp-route-id="@review.CaseId">@review.CaseTitle</a>
                        <span class="case-meta">@review.CreatedAtLabel</span>
                    </div>
                </article>
            }
        </section>

        <section class="health-panel">
            <div class="panel-heading">
                <h2>التقييمات التي قدمتها</h2>
            </div>
            <div class="case-list">
                @foreach (var review in Model.SubmittedReviews)
                {
                    <article class="review-card">
                        <div class="case-card-top">
                            <span class="user-avatar">•</span>
                            <div>
                                <h3>@review.StudentName</h3>
                                <span class="case-meta">@review.AuthorRoleLabel</span>
                            </div>
                        </div>
                        <div class="rating-row">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <span class="star">@(i <= review.Rating ? "★" : "☆")</span>
                            }
                        </div>
                        <p>@review.Comment</p>
                        <div class="row-actions">
                            <a class="status-badge status-draft" asp-controller="Case" asp-action="CaseDetails" asp-route-id="@review.CaseId">@review.CaseTitle</a>
                            <span class="case-meta">@review.CreatedAtLabel</span>
                        </div>
                    </article>
                }
            </div>
        </section>
    </div>
</section>
