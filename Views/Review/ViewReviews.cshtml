@{
    ViewData["Title"] = "التقييمات";
}

<section class="health-page">
    <div class="page-heading">
        <div>
            <h1>التقييمات</h1>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Review" asp-action="AddReview">كتابة تقييم</a>
        </div>
    </div>

    <div class="metric-strip">
        <article class="mini-kpi">
            <div>
                <span class="mini-kpi-label">متوسط التقييم</span>
                <strong><span class="star">★</span> 5.0</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <span class="metric-icon">☝</span>
            <div>
                <span class="mini-kpi-label">التقييمات المستلمة</span>
                <strong>1</strong>
            </div>
        </article>
        <article class="mini-kpi">
            <span class="metric-icon green">☆</span>
            <div>
                <span class="mini-kpi-label">التقييمات المقدمة</span>
                <strong>2</strong>
            </div>
        </article>
    </div>

    <div class="dashboard-columns">
        <section class="health-panel">
            <div class="panel-heading">
                <h2>التقييمات المستلمة</h2>
            </div>
            <article class="review-card">
                <div class="case-card-top">
                    <span class="user-avatar">⌾</span>
                    <div>
                        <h3>أحمد الراشد</h3>
                        <span class="case-meta">طالب</span>
                    </div>
                </div>
                <div class="rating-row">
                    <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
                </div>
                <p>مريضة رائعة! متعاونة جدا واتبعت جميع تعليمات ما بعد العلاج بشكل مثالي.</p>
                <div class="row-actions">
                    <span class="status-badge status-draft">حشو أسنان مطلوب</span>
                    <span class="case-meta">1447/10/28 هـ</span>
                </div>
            </article>
        </section>

        <section class="health-panel">
            <div class="panel-heading">
                <h2>التقييمات التي قدمتها</h2>
            </div>
            <div class="case-list">
                <article class="review-card">
                    <div class="case-card-top">
                        <span class="user-avatar">⌾</span>
                        <div>
                            <h3>أحمد الراشد</h3>
                            <span class="case-meta">طالب</span>
                        </div>
                    </div>
                    <div class="rating-row">
                        <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
                    </div>
                    <p>تجربة ممتازة! أحمد كان محترفا جدا وجعلني أشعر بالراحة طوال الإجراء. أنصح به بشدة.</p>
                    <div class="row-actions">
                        <span class="status-badge status-draft">حشو أسنان مطلوب</span>
                        <span class="case-meta">1447/10/27 هـ</span>
                    </div>
                </article>

                <article class="review-card">
                    <div class="case-card-top">
                        <span class="user-avatar">⌾</span>
                        <div>
                            <h3>أحمد الراشد</h3>
                            <span class="case-meta">طالب</span>
                        </div>
                    </div>
                    <div class="rating-row">
                        <span class="star">☆</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
                    </div>
                    <p>خدمة جيدة بشكل عام. العلاج كان ناجحا والطالب كان لديه معرفة جيدة.</p>
                    <div class="row-actions">
                        <span class="status-badge status-draft">تنظيف الأسنان</span>
                        <span class="case-meta">1447/10/23 هـ</span>
                    </div>
                </article>
            </div>
        </section>
    </div>
</section>
