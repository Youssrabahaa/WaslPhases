@{
    ViewData["Title"] = "حذف الحالة";
}

<section class="health-page">
    <div class="single-state-wrap">
        <div class="state-card danger-state">
            <div class="state-icon state-icon-danger">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18A2 2 0 0 0 3.53 21h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
                </svg>
            </div>
            <h2>هل تريد حذف هذه الحالة؟</h2>
            <p>هذه شاشة تأكيد مؤقتة إلى أن يتم ربط منطق الحذف الحقيقي داخل النظام.</p>
            <div class="form-actions center-actions">
                <a class="danger-action" asp-controller="Case" asp-action="MyCases">حذف الحالة</a>
                <a class="ghost-action" asp-controller="Case" asp-action="CaseDetails" asp-route-id="1">إلغاء</a>
            </div>
        </div>
    </div>
</section>
