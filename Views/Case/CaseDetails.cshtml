@model phase_1.ViewModels.PatientPortal.PatientCaseDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل الحالة";
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">وحدة الحالات</span>
            <h1 class="health-title">@Model.Case.Title</h1>
            <p class="health-subtitle">@Model.Case.Description</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action" asp-controller="Case" asp-action="MyCases">العودة إلى الحالات</a>
            @if (Model.Match is not null)
            {
                <a class="primary-action" asp-controller="Match" asp-action="MatchDetails" asp-route-id="@Model.Match.Id">عرض المطابقة</a>
            }
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>ملخص الحالة</h2>
                        <p>نفس الحالة التي تظهر في صفحة "حالتي" مع ربط مباشر بالمطابقة والجلسات.</p>
                    </div>
                    <span class="status-badge @Model.Case.StatusCssClass">@Model.Case.StatusLabel</span>
                </div>

                <div class="info-grid">
                    <div class="info-block">
                        <span>الفئة</span>
                        <strong>@Model.Case.Category</strong>
                    </div>
                    <div class="info-block">
                        <span>نوع الخدمة</span>
                        <strong>@Model.Case.ServiceType</strong>
                    </div>
                    <div class="info-block">
                        <span>الأولوية</span>
                        <strong>@Model.Case.UrgencyLabel</strong>
                    </div>
                    <div class="info-block">
                        <span>الموقع</span>
                        <strong>@Model.Case.Location</strong>
                    </div>
                </div>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>الخط الزمني</h2>
                        <p>يوضح انتقال الحالة من الإنشاء حتى الجلسات.</p>
                    </div>
                </div>

                <div class="timeline-list">
                    @foreach (var item in Model.Timeline)
                    {
                        <div class="timeline-item">
                            <span class="timeline-dot @item.AccentCssClass"></span>
                            <div>
                                <strong>@item.Title</strong>
                                <p>@item.Description</p>
                            </div>
                            <span class="timeline-time">@item.TimeLabel</span>
                        </div>
                    }
                </div>
            </article>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>ملخص سريع</h2>
                    </div>
                </div>

                <dl class="stacked-list">
                    <div>
                        <dt>رقم الحالة</dt>
                        <dd>#CASE-@Model.Case.Id</dd>
                    </div>
                    <div>
                        <dt>العروض</dt>
                        <dd>@Model.Case.OffersCount عروض</dd>
                    </div>
                    <div>
                        <dt>تاريخ الإنشاء</dt>
                        <dd>@Model.Case.CreatedAtLabel</dd>
                    </div>
                    <div>
                        <dt>الحالة الحالية</dt>
                        <dd>@Model.Case.StatusLabel</dd>
                    </div>
                </dl>
            </article>

            @if (Model.Match is not null)
            {
                <article class="health-panel">
                    <div class="panel-heading">
                        <div>
                            <h2>المطابقة المرتبطة</h2>
                            <p>هذه هي نقطة الربط بين الحالة والجلسات والتقييمات.</p>
                        </div>
                    </div>

                    <div class="action-list">
                        <a class="action-tile" asp-controller="Match" asp-action="MatchDetails" asp-route-id="@Model.Match.Id">
                            <strong>@Model.Match.StudentName</strong>
                            <span>@Model.Match.StatusLabel</span>
                        </a>
                        <a class="action-tile" asp-controller="Session" asp-action="SessionList">
                            <strong>عرض الجلسات</strong>
                            <span>@Model.Match.SessionsCount جلسات مرتبطة بهذه المطابقة.</span>
                        </a>
                    </div>
                </article>
            }
        </aside>
    </div>
</section>
