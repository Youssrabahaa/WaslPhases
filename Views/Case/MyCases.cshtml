@{
    ViewData["Title"] = "My Cases";
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">Case Module</span>
            <h1 class="health-title">My Cases</h1>
            <p class="health-subtitle">A patient-facing case list with practical filters, clean status badges, and simple state previews.</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Case" asp-action="CreateCase">Create case</a>
            <a class="ghost-action" asp-controller="Patients" asp-action="Profile">Patient profile</a>
        </div>
    </div>

    <div class="filter-row">
        <span class="filter-pill active">All cases</span>
        <span class="filter-pill">Open</span>
        <span class="filter-pill">In progress</span>
        <span class="filter-pill">Completed</span>
        <span class="filter-pill">Archived</span>
    </div>

    <section class="health-panel">
        <div class="panel-heading">
            <div>
                <h2>Case List</h2>
                <p>Mock content only, ready for real binding later.</p>
            </div>
        </div>

        <div class="case-list">
            <article class="case-list-item">
                <div class="case-list-main">
                    <div class="case-list-top">
                        <span class="status-badge status-open">Open</span>
                        <span class="case-meta">Home Visit</span>
                        <span class="case-meta">Created today</span>
                    </div>
                    <h3>Follow-up for a child with multiple dental caries</h3>
                    <p>Family is requesting supervised at-home support with a clear prevention plan and short follow-up notes.</p>
                </div>
                <div class="case-list-side">
                    <strong>180 - 250 EGP</strong>
                    <span>Cairo, Nasr City</span>
                    <div class="row-actions">
                        <a class="table-link" asp-controller="Case" asp-action="CaseDetails">Details</a>
                        <a class="table-link" asp-controller="Case" asp-action="EditCase">Edit</a>
                    </div>
                </div>
            </article>

            <article class="case-list-item">
                <div class="case-list-main">
                    <div class="case-list-top">
                        <span class="status-badge status-progress">In progress</span>
                        <span class="case-meta">In-Clinic Session</span>
                        <span class="case-meta">Updated yesterday</span>
                    </div>
                    <h3>Restorative dental treatment for damaged molars</h3>
                    <p>Assessment already accepted by a student. Waiting for the next confirmed clinic slot.</p>
                </div>
                <div class="case-list-side">
                    <strong>220 - 320 EGP</strong>
                    <span>Cairo, Maadi</span>
                    <div class="row-actions">
                        <a class="table-link" asp-controller="Case" asp-action="CaseDetails">Details</a>
                        <a class="table-link" asp-controller="Case" asp-action="EditCase">Edit</a>
                    </div>
                </div>
            </article>

            <article class="case-list-item">
                <div class="case-list-main">
                    <div class="case-list-top">
                        <span class="status-badge status-draft">Draft</span>
                        <span class="case-meta">Online Follow-Up</span>
                        <span class="case-meta">Saved 3 days ago</span>
                    </div>
                    <h3>Remote follow-up after oral surgery consultation</h3>
                    <p>Short symptom check and medication review before the next physical appointment.</p>
                </div>
                <div class="case-list-side">
                    <strong>120 - 150 EGP</strong>
                    <span>Remote</span>
                    <div class="row-actions">
                        <a class="table-link" asp-controller="Case" asp-action="CaseDetails">Details</a>
                        <a class="table-link" asp-controller="Case" asp-action="EditCase">Edit</a>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <section class="state-showcase">
        <div class="panel-heading">
            <div>
                <h2>State Previews</h2>
                <p>Requested UI states for the case list screen.</p>
            </div>
        </div>

        <div class="state-grid">
            @await Html.PartialAsync("_EmptyCasesState")
            @await Html.PartialAsync("_LoadingState")
            @await Html.PartialAsync("_ErrorState")
        </div>
    </section>
</section>
