@model phase_1.ViewModels.PatientPortal.PatientCasesPageViewModel

@{
    ViewData["Title"] = "حالتي";
}

<section class="health-page">
    <div class="page-heading">
        <div>
            <h1>حالتي</h1>
            <p>كل حالة موصولة الآن بتفاصيلها، المطابقة المرتبطة بها، والجلسات الناتجة عنها.</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Case" asp-action="CreateCase">إنشاء حالة جديدة</a>
        </div>
    </div>

    <div class="case-list">
        @foreach (var patientCase in Model.Cases)
        {
            <article class="case-card">
                <div>
                    <div class="case-card-top">
                        <span class="status-badge @patientCase.StatusCssClass">@patientCase.StatusLabel</span>
                        <span class="status-badge @patientCase.UrgencyCssClass">@patientCase.UrgencyLabel</span>
                    </div>
                    <h3>@patientCase.Title</h3>
                    <p>@patientCase.Description</p>
                    <div class="row-actions mt-3">
                        <span class="case-meta">@patientCase.Category</span>
                        <span class="case-meta">@patientCase.Location</span>
                        <span class="case-meta">@patientCase.OffersCount عروض مستلمة</span>
                        <span class="case-meta">@patientCase.CreatedAtLabel</span>
                    </div>
                </div>
                <div class="card-side">
                    <a class="ghost-action compact-action" asp-controller="Case" asp-action="CaseDetails" asp-route-id="@patientCase.Id">تفاصيل الحالة</a>
                    @if (patientCase.MatchId.HasValue)
                    {
                        <a class="ghost-action compact-action" asp-controller="Match" asp-action="MatchDetails" asp-route-id="@patientCase.MatchId.Value">عرض المطابقة</a>
                    }
                </div>
            </article>
        }
    </div>
</section>
