@model phase_1.DTOs.ProfileDTO

@{
    ViewData["Title"] = "ملف المريض";
    var patient = Model.PatientProfile;
    var email = string.IsNullOrWhiteSpace(Model.Email) ? "غير مضاف" : Model.Email;
    var birthDate = patient?.BirthDate?.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-EG")) ?? "غير مضاف";
    var gender = string.IsNullOrWhiteSpace(patient?.Gender) ? "غير مضاف" : patient!.Gender;
    var notes = string.IsNullOrWhiteSpace(patient?.Notes) ? "لا توجد ملاحظات مسجلة حتى الآن." : patient!.Notes;
    var verifiedText = Model.IsPhoneVerified ? "تم تأكيد رقم الهاتف" : "بانتظار تأكيد رقم الهاتف";
    var lastLogin = Model.LastLoginAt?.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-EG")) ?? "أول دخول";
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">بوابة المريض</span>
            <h1 class="health-title">@Model.FullName</h1>
            <p class="health-subtitle">بيانات حسابك محفوظة من التسجيل، ويمكنك مراجعة رقم الهاتف والبريد وبيانات ملف المريض من هنا.</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Patients" asp-action="EditProfile">تعديل الملف</a>
            <a class="ghost-action" asp-controller="Case" asp-action="MyCases">عرض الحالات</a>
        </div>
    </div>

    <div class="metric-strip">
        <article class="mini-kpi">
            <span class="mini-kpi-label">حالة الحساب</span>
            <strong>@(Model.Status == 1 ? "نشط" : "غير نشط")</strong>
            <span class="mini-kpi-meta">@verifiedText</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">نوع الحساب</span>
            <strong>مريض</strong>
            <span class="mini-kpi-meta">تم إنشاؤه في @Model.CreatedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">آخر دخول</span>
            <strong>@lastLogin</strong>
            <span class="mini-kpi-meta">يعتمد على آخر تسجيل دخول ناجح</span>
        </article>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>بيانات الحساب</h2>
                        <p>هذه البيانات مأخوذة من الحساب الذي سجلت به.</p>
                    </div>
                </div>

                <div class="info-grid">
                    <div class="info-block">
                        <span>الاسم بالكامل</span>
                        <strong>@Model.FullName</strong>
                    </div>
                    <div class="info-block">
                        <span>رقم الهاتف</span>
                        <strong>@Model.Phone</strong>
                    </div>
                    <div class="info-block">
                        <span>البريد الإلكتروني</span>
                        <strong>@email</strong>
                    </div>
                    <div class="info-block">
                        <span>تأكيد الهاتف</span>
                        <strong>@verifiedText</strong>
                    </div>
                </div>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>بيانات المريض</h2>
                        <p>بيانات الملف المرتبطة بحساب المريض.</p>
                    </div>
                </div>

                <div class="info-grid">
                    <div class="info-block">
                        <span>تاريخ الميلاد</span>
                        <strong>@birthDate</strong>
                    </div>
                    <div class="info-block">
                        <span>النوع</span>
                        <strong>@gender</strong>
                    </div>
                </div>

                <p class="body-copy mt-3">@notes</p>
            </article>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>اختصارات</h2>
                        <p>إجراءات مرتبطة بحسابك الحالي.</p>
                    </div>
                </div>
                <div class="action-list">
                    <a class="action-tile" asp-controller="Case" asp-action="CreateCase">
                        <strong>إنشاء حالة جديدة</strong>
                        <span>ابدأ طلب علاج جديد مرتبط بحسابك.</span>
                    </a>
                    <a class="action-tile" asp-controller="Patients" asp-action="EditProfile">
                        <strong>تحديث بيانات الملف</strong>
                        <span>راجع بيانات التواصل والبيانات الشخصية.</span>
                    </a>
                </div>
            </article>
        </aside>
    </div>
</section>
