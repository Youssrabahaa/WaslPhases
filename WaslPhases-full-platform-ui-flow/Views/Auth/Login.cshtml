@{
    ViewData["Title"] = "تسجيل الدخول";
}

<section class="auth-page">
    <div class="auth-visual">
        <div class="auth-visual-content">
            <span class="health-kicker">بوابة وصل</span>
            <h1>سجل دخولك وتابع خطواتك.</h1>
            <p>استخدم رقم الهاتف وكلمة المرور التي سجلت بها.</p>
        </div>
    </div>

    <article class="auth-card">
        <span class="health-kicker">دخول</span>
        <h2>تسجيل الدخول</h2>
        <p>اكتب رقم الهاتف المسجل وكلمة المرور.</p>

        <form class="form-panel" action="/Auth/LoginForm" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <label class="field-group">
                <span>رقم الهاتف</span>
                <input class="form-control modern-input" name="Phone" inputmode="tel" placeholder="01012345678" required />
            </label>

            <label class="field-group">
                <span>كلمة المرور</span>
                <input class="form-control modern-input" name="Password" type="password" placeholder="كلمة المرور" required />
            </label>

            <label class="field-group d-flex flex-row align-items-center gap-2">
                <input name="RememberMe" type="checkbox" value="true" />
                <span>تذكرني</span>
            </label>

            <button class="primary-action loading-button" type="submit">
                <span class="button-label">دخول</span>
                <span class="button-loader"></span>
            </button>
        </form>

        <div class="row-actions mt-3">
            <a class="text-link" asp-controller="Auth" asp-action="ForgotPassword">نسيت كلمة المرور؟</a>
            <a class="text-link" asp-controller="Auth" asp-action="Register">إنشاء حساب</a>
        </div>
    </article>
</section>
