@{
    ViewData["Title"] = "تأكيد رقم الهاتف";
    var phone = ViewData["Phone"]?.ToString() ?? string.Empty;
    var purpose = ViewData["Purpose"]?.ToString() ?? "1";
    var debugOtp = ViewData["DebugOtp"]?.ToString();
}

<section class="auth-page">
    <div class="auth-visual">
        <div class="auth-visual-content">
            <span class="health-kicker">تأكيد الهاتف</span>
            <h1>أكد رقم هاتفك.</h1>
            <p>اكتب رمز التحقق لإكمال خطوة التأكيد.</p>
        </div>
    </div>

    <article class="auth-card">
        <span class="health-kicker">رمز التحقق</span>
        <h2>تأكيد الرمز</h2>
        <p>اكتب الرمز المرسل إلى <strong>@phone</strong>.</p>

        @if (TempData["AuthMessage"] != null)
        {
            <div class="alert alert-success" style="padding: 10px 15px; border-radius: 8px; font-size: 0.9rem; margin-bottom: 15px;">
                @TempData["AuthMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="padding: 10px 15px; border-radius: 8px; font-size: 0.9rem; margin-bottom: 15px;">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(debugOtp))
        {
            <div class="alert-soft-info" style="margin-bottom: 15px;">رمز التحقق التجريبي: <strong>@debugOtp</strong></div>
        }

        <form class="form-panel" action="/Auth/VerifyOtpForm" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="Phone" value="@phone" />
            <input type="hidden" name="Purpose" value="@purpose" />

            <label class="field-group">
                <span>رمز التحقق</span>
                <input class="form-control modern-input text-center" name="Code" inputmode="numeric" maxlength="6" placeholder="123456" required />
            </label>

            <button class="primary-action loading-button" type="submit">
                <span class="button-label">تأكيد الرمز</span>
                <span class="button-loader"></span>
            </button>
        </form>

        <div class="row-actions mt-3">
            <a class="text-link" asp-controller="Auth" asp-action="Login">تغيير رقم الهاتف</a>
            <a class="text-link" asp-controller="Auth" asp-action="Register">التسجيل مرة أخرى</a>
        </div>
    </article>
</section>
