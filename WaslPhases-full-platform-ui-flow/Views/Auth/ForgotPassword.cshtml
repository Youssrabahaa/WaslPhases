@{
    ViewData["Title"] = "نسيت كلمة المرور";
}

<section class="auth-page">
    <div class="auth-visual">
        <div class="auth-visual-content">
            <span class="health-kicker">استعادة الحساب</span>
            <h1>غيّر كلمة المرور برمز تحقق.</h1>
            <p>اكتب رقم الهاتف للانتقال إلى خطوة تعيين كلمة مرور جديدة.</p>
        </div>
    </div>

    <article class="auth-card">
        <span class="health-kicker">استعادة</span>
        <h2>نسيت كلمة المرور</h2>
        <p>سننشئ رمز تحقق تجريبي لهذا الرقم.</p>

        <form class="form-panel" action="/Auth/ForgotPasswordForm" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <label class="field-group">
                <span>رقم الهاتف</span>
                <input class="form-control modern-input" name="Phone" inputmode="tel" placeholder="01012345678" required />
            </label>

            <button class="primary-action loading-button" type="submit">
                <span class="button-label">إرسال رمز الاستعادة</span>
                <span class="button-loader"></span>
            </button>
        </form>

        <a class="text-link d-inline-block mt-3" asp-controller="Auth" asp-action="Login">العودة لتسجيل الدخول</a>
    </article>
</section>
