@{
    ViewData["Title"] = "تغيير كلمة المرور";
    var phone = ViewData["Phone"]?.ToString() ?? string.Empty;
    var debugOtp = ViewData["DebugOtp"]?.ToString();
}

<section class="auth-page">
    <div class="auth-visual">
        <div class="auth-visual-content">
            <span class="health-kicker">كلمة مرور جديدة</span>
            <h1>اختر كلمة مرور جديدة.</h1>
            <p>استخدم رمز التحقق وكلمة المرور الجديدة لإنهاء الاستعادة.</p>
        </div>
    </div>

    <article class="auth-card">
        <span class="health-kicker">تغيير</span>
        <h2>تغيير كلمة المرور</h2>
        <p>اكتب الرمز المرسل إلى <strong>@phone</strong>.</p>

        @if (!string.IsNullOrWhiteSpace(debugOtp))
        {
            <div class="alert-soft-info">رمز التحقق التجريبي: <strong>@debugOtp</strong></div>
        }

        <form class="form-panel" action="/Auth/ResetPasswordForm" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="Phone" value="@phone" />

            <label class="field-group">
                <span>رمز التحقق</span>
                <input class="form-control modern-input" name="Code" inputmode="numeric" placeholder="123456" required />
            </label>

            <label class="field-group">
                <span>كلمة المرور الجديدة</span>
                <input class="form-control modern-input" name="NewPassword" type="password" placeholder="كلمة المرور الجديدة" required />
            </label>

            <label class="field-group">
                <span>تأكيد كلمة المرور الجديدة</span>
                <input class="form-control modern-input" name="ConfirmNewPassword" type="password" placeholder="أعد كتابة كلمة المرور الجديدة" required />
            </label>

            <button class="primary-action loading-button" type="submit">
                <span class="button-label">تحديث كلمة المرور</span>
                <span class="button-loader"></span>
            </button>
        </form>
    </article>
</section>
