@{
    var sessionRole = Context.Session.GetInt32("UserRole");
    var portalRoute = sessionRole == 1 ? "patient"
        : sessionRole == 2 ? "student"
        : ViewContext.RouteData.Values["portal"]?.ToString();
    var isPatient = sessionRole == 1 || string.Equals(portalRoute, "patient", StringComparison.OrdinalIgnoreCase);
}

<footer class="app-footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <a class="footer-brand" asp-controller="Home" asp-action="Index" asp-route-portal="@portalRoute">وصل</a>
                <p>منصة تنسيق ذكية تربط المرضى بطلاب الرعاية الصحية تحت إشراف واضح وتجربة استخدام هادئة.</p>
            </div>

            <div class="footer-links">
                @if (isPatient)
                {
                    <a asp-controller="Case" asp-action="MyCases" asp-route-portal="@portalRoute">حالاتي</a>
                }
                else
                {
                    <a asp-controller="Offer" asp-action="BrowseCases" asp-route-portal="@portalRoute">الحالات</a>
                }
                <a asp-controller="Session" asp-action="SessionList" asp-route-portal="@portalRoute">الجلسات</a>
                <a asp-controller="Review" asp-action="ViewReviews" asp-route-portal="@portalRoute">التقييمات</a>
                <a asp-controller="Auth" asp-action="Logout">تسجيل الخروج</a>
            </div>
        </div>
    </div>
</footer>
