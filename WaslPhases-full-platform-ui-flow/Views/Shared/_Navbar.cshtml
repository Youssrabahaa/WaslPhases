@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var currentPortal = ViewContext.RouteData.Values["portal"]?.ToString()
        ?? ViewData["Portal"]?.ToString()
        ?? string.Empty;
    var isAuthPage = string.Equals(currentController, "Auth", StringComparison.OrdinalIgnoreCase);

    // ✅ قراءة Role من Session — المصدر الحقيقي
    var navRole = Context.Session.GetInt32("UserRole") ?? 0;
    var navUserId = Context.Session.GetInt32("UserId") ?? 0;
    var isLoggedIn = navUserId > 0;

    string NavLinkClass(string controller, string? action = null)
    {
        var cm = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        var am = action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return cm && am ? "nav-pill active" : "nav-pill";
    }

    var isPatientArea = navRole == 1
        || (navRole == 0 && (
            string.Equals(currentPortal, "patient", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentController, "Patients", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentController, "Case", StringComparison.OrdinalIgnoreCase)));

    var portalRoute = isPatientArea ? "patient" : "student";
    var portalTitle = isAuthPage ? "بوابة التسجيل" : isPatientArea ? "بوابة المريض" : "بوابة الطالب";
    var portalHomeController = isAuthPage ? "Auth" : isPatientArea ? "Patients" : "Home";
    var portalHomeAction = isAuthPage ? "Register" : isPatientArea ? "Profile" : "Index";
}

<header class="app-shell-header">
    <nav class="navbar navbar-expand-xl app-navbar">
        <div class="container">
            <a class="app-brand"
               asp-controller="@portalHomeController"
               asp-action="@portalHomeAction"
               asp-route-portal="@portalRoute"
               aria-label="وصل">
                <span class="app-brand-mark">و</span>
                <span>
                    <strong>وصل</strong>
                    <small>@portalTitle</small>
                </span>
            </a>

            <button class="navbar-toggler app-nav-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation"
                    aria-expanded="false"
                    aria-label="فتح القائمة">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse app-navbar-collapse" id="mainNavigation">
                @if (!isAuthPage && isLoggedIn)
                {
                    <div class="app-nav-links">
                        @if (navRole == 1) @* Patient *@
                        {
                            <a class="@NavLinkClass("Patients", "Profile")"
                               asp-controller="Patients" asp-action="Profile"
                               asp-route-portal="patient">الرئيسية</a>

                            @* ✅ Patient يشوف حالاته والعروض عليها *@
                            <a class="@NavLinkClass("Case")"
                               asp-controller="Case" asp-action="MyCases"
                               asp-route-portal="patient">حالاتي والعروض</a>

                            @* ✅ Patient يشوف مطابقاته *@
                            <a class="@NavLinkClass("Match")"
                               asp-controller="Match" asp-action="PatientMatches"
                               asp-route-portal="patient">مطابقاتي</a>

                            @* ✅ Patient يشوف الجلسات (view only) — لكن مش من Navbar مباشرة *@
                            <a class="@NavLinkClass("Review")"
                               asp-controller="Review" asp-action="ViewReviews"
                               asp-route-portal="patient">التقييمات</a>

                            <a class="@NavLinkClass("Notification")"
                               asp-controller="Notification" asp-action="GetNotifications"
                               asp-route-portal="patient">الإشعارات</a>
                        }
                        else if (navRole == 2) @* Student *@
                        {
                            <a class="@NavLinkClass("Home", "Index")"
                               asp-controller="Home" asp-action="Index"
                               asp-route-portal="student">الرئيسية</a>

                            @* ✅ Student يتصفح الحالات ويقدم عروض *@
                            <a class="@NavLinkClass("Offer", "BrowseCases")"
                               asp-controller="Offer" asp-action="BrowseCases"
                               asp-route-portal="student">تصفح الحالات</a>

                            @* ✅ Student يشوف عروضه *@
                            <a class="@NavLinkClass("Offer", "MyOffers")"
                               asp-controller="Offer" asp-action="MyOffers"
                               asp-route-portal="student">عروضي</a>

                            @* ✅ Student يشوف مطابقاته *@
                            <a class="@NavLinkClass("Match")"
                               asp-controller="Match" asp-action="StudentMatches"
                               asp-route-portal="student">مطابقاتي</a>

                            <a class="@NavLinkClass("Review")"
                               asp-controller="Review" asp-action="ViewReviews"
                               asp-route-portal="student">التقييمات</a>

                            <a class="@NavLinkClass("Notification")"
                               asp-controller="Notification" asp-action="GetNotifications"
                               asp-route-portal="student">الإشعارات</a>
                        }
                        else if (navRole == 3) @* Admin *@
                        {
                            <a class="@NavLinkClass("Admin", "Dashboard")"
                               asp-controller="Admin" asp-action="Dashboard">لوحة التحكم</a>
                            <a class="@NavLinkClass("Admin", "Reports")"
                               asp-controller="Admin" asp-action="Reports">البلاغات</a>
                        }
                    </div>
                }

                <div class="app-shell-actions">
                    @if (!isLoggedIn || isAuthPage)
                    {
                        <a class="ghost-action compact-action" asp-controller="Auth" asp-action="Login">دخول</a>
                        <a class="primary-action compact-action" asp-controller="Auth" asp-action="Register">حساب جديد</a>
                    }
                    else
                    {
                        <a class="ghost-action compact-action" asp-controller="Auth" asp-action="Logout">خروج</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>
