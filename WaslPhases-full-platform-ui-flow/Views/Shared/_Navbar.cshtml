@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var currentPortal = ViewContext.RouteData.Values["portal"]?.ToString()
        ?? ViewData["Portal"]?.ToString()
        ?? string.Empty;

    string NavLinkClass(string controller, string? action = null)
    {
        var controllerMatches = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        var actionMatches = action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return controllerMatches && actionMatches ? "nav-pill active" : "nav-pill";
    }
    var isPatientArea = string.Equals(currentPortal, "patient", StringComparison.OrdinalIgnoreCase)
        || (string.IsNullOrEmpty(currentPortal)
            && (string.Equals(currentController, "Patients", StringComparison.OrdinalIgnoreCase)
                || (string.Equals(currentController, "Case", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(currentAction, "CaseDetails", StringComparison.OrdinalIgnoreCase))));

    var portalRoute = isPatientArea ? "patient" : "student";
    var portalTitle = isPatientArea ? "بوابة المريض" : "بوابة الطالب";
    var portalHomeController = isPatientArea ? "Patients" : "Home";
    var portalHomeAction = isPatientArea ? "Profile" : "Index";
}

<header class="app-shell-header">
    <nav class="navbar navbar-expand-xl app-navbar">
        <div class="container">
            <a class="app-brand" asp-controller="@portalHomeController" asp-action="@portalHomeAction" asp-route-portal="@portalRoute" aria-label="وصل">
                <span class="app-brand-mark">و</span>
                <span>
                    <strong>وصل</strong>
                    <small>@portalTitle</small>
                </span>
            </a>
            <button class="navbar-toggler app-nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation" aria-expanded="false" aria-label="فتح القائمة">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse app-navbar-collapse" id="mainNavigation">
                <div class="app-nav-links">
                    @if (isPatientArea)
                    {
                        <a class="@NavLinkClass("Patients", "Profile")" asp-controller="Patients" asp-action="Profile" asp-route-portal="@portalRoute">الرئيسية</a>
                        <a class="@NavLinkClass("Case", "MyCases")" asp-controller="Case" asp-action="MyCases" asp-route-portal="@portalRoute">حالاتي</a>
                        <a class="@NavLinkClass("Session")" asp-controller="Session" asp-action="SessionList" asp-route-portal="@portalRoute">الجلسات</a>
                        <a class="@NavLinkClass("Review")" asp-controller="Review" asp-action="ViewReviews" asp-route-portal="@portalRoute">التقييمات</a>
                        <a class="@NavLinkClass("Notification")" asp-controller="Notification" asp-action="GetNotifications" asp-route-portal="@portalRoute">الإشعارات</a>
                    }
                    else
                    {
                        <a class="@NavLinkClass("Home", "Index")" asp-controller="Home" asp-action="Index" asp-route-portal="@portalRoute">الرئيسية</a>
                        <a class="@NavLinkClass("Offer", "BrowseCases")" asp-controller="Offer" asp-action="BrowseCases" asp-route-portal="@portalRoute">تصفح الحالات</a>
                        <a class="@NavLinkClass("Offer", "MyOffers")" asp-controller="Offer" asp-action="MyOffers" asp-route-portal="@portalRoute">عروضي</a>
                        <a class="@NavLinkClass("Match", "MatchDetails")" asp-controller="Match" asp-action="MatchDetails" asp-route-portal="@portalRoute">المطابقات</a>
                        <a class="@NavLinkClass("Session")" asp-controller="Session" asp-action="SessionList" asp-route-portal="@portalRoute">الجلسات</a>
                        <a class="@NavLinkClass("Review")" asp-controller="Review" asp-action="ViewReviews" asp-route-portal="@portalRoute">التقييمات</a>
                        <a class="@NavLinkClass("Notification")" asp-controller="Notification" asp-action="GetNotifications" asp-route-portal="@portalRoute">الإشعارات</a>
                    }
                </div>

                <div class="app-shell-actions">
                    <a class="ghost-action compact-action" asp-controller="Auth" asp-action="Login">دخول</a>
                    <a class="primary-action compact-action" asp-controller="Auth" asp-action="Register">حساب جديد</a>
                </div>
            </div>
        </div>
</nav>
</header>
