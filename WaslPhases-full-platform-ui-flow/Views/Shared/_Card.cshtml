@{
    var sessionRole = Context.Session.GetInt32("UserRole");
    var cardController = sessionRole == 1 ? "Case" : "Offer";
    var cardAction = sessionRole == 1 ? "MyCases" : "BrowseCases";
    var portalRoute = sessionRole == 1 ? "patient" : sessionRole == 2 ? "student" : null;
}
<article class="feature-card">
    <span class="feature-icon">+</span>
    <h3>مكون بطاقة موحد</h3>
    <p>استخدم نفس البنية لعرض حالة، عرض، جلسة، إشعار، أو خطوة داخل رحلة المستخدم.</p>
    <a class="text-link" asp-controller="@cardController" asp-action="@cardAction" asp-route-portal="@portalRoute">عرض مثال عملي</a>
</article>
