@model phase_1.BLL.DTOs.CreateReviewDTO
@{
    ViewData["Title"] = "إضافة تقييم";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
    var matchId = Model?.MatchId ?? ViewBag.MatchId ?? 0;
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">إضافة تقييم</span>
            <h1 class="health-title">سجّل تقييمك للمطابقة</h1>
            <p class="health-subtitle">التقييم متاح فقط بعد اكتمال المطابقة.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action"
               asp-controller="Match"
               asp-action="MatchDetails"
               asp-route-id="@matchId"
               asp-route-portal="@portalRoute">← العودة للمطابقة</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert-soft-danger">@TempData["Error"]</div>
    }

    <div class="content-grid">
        <section class="content-main">
            <form class="health-panel form-panel"
                  asp-controller="Review"
                  asp-action="AddReview"
                  asp-route-portal="@portalRoute"
                  method="post">
                @Html.AntiForgeryToken()

                @* ✅ Hidden fields مطلوبة *@
                <input type="hidden" asp-for="MatchId" />
                <input type="hidden" asp-for="RevieweeUserId" />

                <label class="field-group">
                    <span>التقييم</span>
                    <select asp-for="Rating" class="form-select modern-input">
                        <option value="5">5 نجوم — ممتاز</option>
                        <option value="4">4 نجوم — جيد جداً</option>
                        <option value="3">3 نجوم — جيد</option>
                        <option value="2">2 نجوم — يحتاج تحسين</option>
                        <option value="1">1 نجمة — تجربة ضعيفة</option>
                    </select>
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </label>

                <label class="field-group">
                    <span>تعليق (اختياري)</span>
                    <textarea asp-for="Comment"
                              class="form-control modern-input modern-textarea"
                              rows="5"
                              placeholder="اكتب ملاحظة تساعد على تحسين الخدمة."></textarea>
                </label>

                <div class="form-actions">
                    <button type="submit" class="primary-action">حفظ التقييم</button>
                    <a class="ghost-action"
                       asp-controller="Match"
                       asp-action="MatchDetails"
                       asp-route-id="@matchId"
                       asp-route-portal="@portalRoute">إلغاء</a>
                </div>
            </form>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>قبل التقييم</h2>
                        <p>ملاحظات مهمة.</p>
                    </div>
                </div>
                <ul class="clean-list">
                    <li>التقييم يظهر بعد اكتمال المطابقة.</li>
                    <li>اكتب تعليق عملي ومحترم.</li>
                    <li>لا تشارك بيانات طبية حساسة.</li>
                    <li>استخدم البلاغات للمشاكل التي تحتاج تدخل إدارة.</li>
                </ul>
            </article>
        </aside>
    </div>
</section>
