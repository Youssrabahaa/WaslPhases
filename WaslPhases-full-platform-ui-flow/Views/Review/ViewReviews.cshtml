@model List<phase_1.BLL.DTOs.ReviewDTO>
@{
    ViewData["Title"] = "التقييمات";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
    var uid = Context.Session.GetInt32("UserId") ?? 0;
    var role = Context.Session.GetInt32("UserRole") ?? 0;

    var avg = Model.Any() ? Model.Average(r => r.Rating) : 0.0;
    var stars = (int)Math.Round(avg);
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">التقييمات</span>
            <h1 class="health-title">تقييماتك من المطابقات المكتملة</h1>
            <p class="health-subtitle">كل تقييم مرتبط بمطابقة حقيقية بين مريض وطالب.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="app-toast"><span class="app-toast-dot"></span>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-soft-danger">@TempData["Error"]</div>
    }

    @* KPI Strip *@
    <div class="metric-strip">
        <article class="mini-kpi">
            <span class="mini-kpi-label">متوسط التقييم</span>
            <strong>@avg.ToString("F1")</strong>
            <span class="mini-kpi-meta">من 5</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">عدد التقييمات</span>
            <strong>@Model.Count</strong>
            <span class="mini-kpi-meta">إجمالي</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">التقييم الأخير</span>
            <strong>
                @(Model.Any()
                    ? Model.OrderByDescending(r => r.CreatedAt).First().Rating + " ★"
                    : "—")
            </strong>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">المتوسط</span>
            <strong>
                @for (int i = 1; i <= 5; i++)
                {
                    <span style="color: @(i <= stars ? "#f59e0b" : "#d1d5db")">★</span>
                }
            </strong>
        </article>
    </div>

    @if (Model.Any())
    {
        <div class="review-grid">
            @foreach (var r in Model.OrderByDescending(x => x.CreatedAt))
            {
                <article class="review-card">
                    <div class="rating-row">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="star" style="color: @(i <= r.Rating ? "#f59e0b" : "#d1d5db")">★</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(r.Comment))
                    {
                        <p>@r.Comment</p>
                    }
                    <div class="info-grid mt-2" style="font-size:0.85rem;">
                        <div class="info-block">
                            <span>من</span>
                            <strong>@r.ReviewerName</strong>
                        </div>
                        <div class="info-block">
                            <span>إلى</span>
                            <strong>@r.ReviewedName</strong>
                        </div>
                        <div class="info-block">
                            <span>التاريخ</span>
                            <strong>@r.CreatedAt.ToString("dd MMM yyyy")</strong>
                        </div>
                        <div class="info-block">
                            <span>المطابقة</span>
                            <a class="ghost-action compact-action"
                               asp-controller="Match"
                               asp-action="MatchDetails"
                               asp-route-id="@r.MatchId"
                               asp-route-portal="@portalRoute">مطابقة #@r.MatchId</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <section class="state-grid">
            <article class="empty-state-card">
                <span class="empty-state-icon">⭐</span>
                <h3>لا توجد تقييمات بعد</h3>
                <p>التقييمات تظهر هنا بعد اكتمال المطابقات.</p>
                <a class="ghost-action mt-3"
                   asp-controller="Match"
                   asp-action="Index"
                   asp-route-portal="@portalRoute">مطابقاتي</a>
            </article>
        </section>
    }
</section>