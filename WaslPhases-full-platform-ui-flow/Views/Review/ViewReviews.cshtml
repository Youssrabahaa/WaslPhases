@model List<phase_1.BLL.DTOs.ReviewDTO>
@{
    ViewData["Title"] = "عرض التقييمات";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
    var averageRating = ViewBag.AverageRating as string ?? "0.0";
    var reviewsCount = ViewBag.ReviewsCount ?? 0;
    var positivePercentage = ViewBag.PositivePercentage ?? 100;
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">بوابة التقييمات والآراء</span>
            <h1 class="health-title">تقييمات الأعضاء والشركاء في المنصة</h1>
            <p class="health-subtitle">آراء حقيقية تساعدنا في رفع مستوى الالتزام والاحترافية الطبية.</p>
        </div>
    </div>

    <div class="metric-strip">
        <article class="mini-kpi">
            <span class="mini-kpi-label">متوسط التقييم</span>
            <strong>⭐ @averageRating</strong>
            <span class="mini-kpi-meta">من 5 نقاط</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">إجمالي التقييمات</span>
            <strong>@reviewsCount</strong>
            <span class="mini-kpi-meta">تقييمات مسجلة</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">نسبة الرضا والالتزام</span>
            <strong>%@positivePercentage</strong>
            <span class="mini-kpi-meta">تقييمات إيجابية (4+)</span>
        </article>
    </div>

    <div class="review-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var review in Model)
            {
                <article class="review-card">
                    <div class="rating-row">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= review.Rating)
                            {
                                <span class="star" style="color: #f59e0b;">★</span>
                            }
                            else
                            {
                                <span class="star" style="color: #d1d5db;">★</span>
                            }
                        }
                    </div>
                    <h3>مكتوبة لـ: @review.ReviewedName</h3>
                    <p>@(string.IsNullOrWhiteSpace(review.Comment) ? "بدون تعليق مكتوب." : review.Comment)</p>
                    <span class="case-meta">بواسطة: @review.ReviewerName — @review.CreatedAt.ToString("dd/MM/yyyy")</span>
                </article>
            }
        }
        else
        {
            <div style="grid-column: 1 / -1;">
                @await Html.PartialAsync("_EmptyState")
            </div>
        }
    </div>
</section>
