@{
    ViewData["Title"] = "حالاتي";
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">وحدة الحالات</span>
            <h1 class="health-title">حالاتي</h1>
            <p class="health-subtitle">قائمة حالات موجهة للمريض مع فلاتر عملية، وشارات حالة واضحة، ومعاينات مبسطة للحالات المختلفة.</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Case" asp-action="CreateCase">إنشاء حالة</a>
            <a class="ghost-action" asp-controller="Patients" asp-action="Profile">ملف المريض</a>
        </div>
    </div>

    <div class="filter-row">
        <span class="filter-pill active">كل الحالات</span>
        <span class="filter-pill">مفتوحة</span>
        <span class="filter-pill">قيد التنفيذ</span>
        <span class="filter-pill">مكتملة</span>
        <span class="filter-pill">مؤرشفة</span>
    </div>

    <section class="health-panel">
        <div class="panel-heading">
            <div>
                <h2>قائمة الحالات</h2>
                <p>محتوى تجريبي حاليًا وجاهز للربط بالبيانات الفعلية لاحقًا.</p>
            </div>
        </div>

        <div class="case-list">
            <article class="case-list-item">
                <div class="case-list-main">
                    <div class="case-list-top">
                        <span class="status-badge status-open">مفتوحة</span>
                        <span class="case-meta">زيارة منزلية</span>
                        <span class="case-meta">تم إنشاؤها اليوم</span>
                    </div>
                    <h3>متابعة لطفل يعاني من تسوسات متعددة بالأسنان</h3>
                    <p>الأسرة تطلب دعمًا منزليًا بإشراف مع خطة وقائية واضحة وملاحظات متابعة قصيرة بعد كل زيارة.</p>
                </div>
                <div class="case-list-side">
                    <strong>180 - 250 ج.م</strong>
                    <span>القاهرة، مدينة نصر</span>
                    <div class="row-actions">
                        <a class="table-link" asp-controller="Case" asp-action="CaseDetails">التفاصيل</a>
                        <a class="table-link" asp-controller="Case" asp-action="EditCase">تعديل</a>
                    </div>
                </div>
            </article>

            <article class="case-list-item">
                <div class="case-list-main">
                    <div class="case-list-top">
                        <span class="status-badge status-progress">قيد التنفيذ</span>
                        <span class="case-meta">جلسة داخل العيادة</span>
                        <span class="case-meta">تم تحديثها أمس</span>
                    </div>
                    <h3>علاج تحفظي لضروس متضررة</h3>
                    <p>تم قبول التقييم من قبل أحد الطلاب، وننتظر تأكيد الموعد القادم داخل العيادة.</p>
                </div>
                <div class="case-list-side">
                    <strong>220 - 320 ج.م</strong>
                    <span>القاهرة، المعادي</span>
                    <div class="row-actions">
                        <a class="table-link" asp-controller="Case" asp-action="CaseDetails">التفاصيل</a>
                        <a class="table-link" asp-controller="Case" asp-action="EditCase">تعديل</a>
                    </div>
                </div>
            </article>

            <article class="case-list-item">
                <div class="case-list-main">
                    <div class="case-list-top">
                        <span class="status-badge status-draft">مسودة</span>
                        <span class="case-meta">متابعة أونلاين</span>
                        <span class="case-meta">تم حفظها منذ 3 أيام</span>
                    </div>
                    <h3>متابعة عن بُعد بعد استشارة جراحة فم</h3>
                    <p>مراجعة مختصرة للأعراض والأدوية قبل الزيارة الحضورية التالية.</p>
                </div>
                <div class="case-list-side">
                    <strong>120 - 150 ج.م</strong>
                    <span>عن بُعد</span>
                    <div class="row-actions">
                        <a class="table-link" asp-controller="Case" asp-action="CaseDetails">التفاصيل</a>
                        <a class="table-link" asp-controller="Case" asp-action="EditCase">تعديل</a>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <section class="state-showcase">
        <div class="panel-heading">
            <div>
                <h2>معاينات الحالات</h2>
                <p>حالات واجهة مطلوبة لشاشة قائمة الحالات.</p>
            </div>
        </div>

        <div class="state-grid">
            @await Html.PartialAsync("_EmptyCasesState")
            @await Html.PartialAsync("_LoadingState")
            @await Html.PartialAsync("_ErrorState")
        </div>
    </section>
</section>
