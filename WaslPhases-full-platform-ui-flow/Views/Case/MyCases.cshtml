@model List<phase_1.BLL.DTOs.CaseListDTO>
@{
    ViewData["Title"] = "حالاتي";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">بوابة المريض</span>
            <h1 class="health-title">حالاتي</h1>
            <p class="health-subtitle">قائمة الحالات التي نشرتها — اضغط على الحالة لمراجعة العروض وقبول أحدها.</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action"
               asp-controller="Case"
               asp-action="CreateCase"
               asp-route-portal="@portalRoute">+ نشر حالة جديدة</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="app-toast"><span class="app-toast-dot"></span>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-soft-danger">@TempData["Error"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="offer-list">
            @foreach (var c in Model)
            {
                
                    var cls = c.Status == 1 ? "status-inprogress"
                            : c.Status == 2 ? "status-completed"
                            : "status-rejected";

                    // ✅ إشارة واضحة لو في عروض على الحالة المفتوحة
                    var hasOffers = c.OffersCount > 0 && c.Status == 1;
                
                <article class="session-card" style="@(hasOffers ? "border-right: 3px solid var(--teal);" : "")">
                    <div>
                        <div class="case-card-top">
                            <span class="status-badge @cls">@c.StatusText</span>
                            <span class="case-meta">@c.TreatmentCategoryName</span>

                            @* ✅ badge يظهر لو في عروض جديدة *@
                            @if (hasOffers)
                            {
                                <span class="status-badge status-inprogress">
                                    🔔 @c.OffersCount عرض جديد
                                </span>
                            }
                        </div>

                        <h3>@c.Title</h3>
                        <p class="case-meta">@c.Governorate — @c.City</p>

                        @if (hasOffers)
                        {
                            <p class="case-meta" style="color: var(--teal); font-weight: 600;">
                                ✅ وصلك @c.OffersCount عرض من طلاب الأسنان — اضغط "مراجعة العروض" للقبول
                            </p>
                        }

                        <div class="row-actions mt-3">
                            @if (hasOffers)
                            {
                                <a class="primary-action compact-action"
                                   asp-controller="Case"
                                   asp-action="CaseDetails"
                                   asp-route-id="@c.Id"
                                   asp-route-portal="@portalRoute">
                                    🔔 مراجعة العروض (@c.OffersCount)
                                </a>
                            }
                            else
                            {
                                <a class="primary-action compact-action"
                                   asp-controller="Case"
                                   asp-action="CaseDetails"
                                   asp-route-id="@c.Id"
                                   asp-route-portal="@portalRoute">التفاصيل</a>
                            }

                            @if (c.Status == 1)
                            {
                                <a class="ghost-action compact-action"
                                   asp-controller="Case"
                                   asp-action="EditCase"
                                   asp-route-id="@c.Id"
                                   asp-route-portal="@portalRoute">تعديل</a>

                                <form asp-controller="Case"
                                      asp-action="CloseCase"
                                      asp-route-portal="@portalRoute"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('هل تريد إغلاق هذه الحالة؟')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="danger-action compact-action">إغلاق</button>
                                </form>
                            }
                        </div>
                    </div>
                    <div class="card-side">
                        <strong>@c.ServiceTypeName</strong>
                        @if (c.OffersCount > 0)
                        {
                            <span class="status-badge status-inprogress">@c.OffersCount عرض</span>
                        }
                        <span class="case-meta">@c.CreatedAt.ToString("dd MMM yyyy")</span>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <section class="state-grid">
            <article class="empty-state-card">
                <span class="empty-state-icon">📋</span>
                <h3>لا توجد حالات بعد</h3>
                <p>انشر حالتك الأولى وستصلك عروض من طلاب الأسنان.</p>
                <div class="mt-3">
                    <a class="primary-action"
                       asp-controller="Case"
                       asp-action="CreateCase"
                       asp-route-portal="@portalRoute">نشر حالة جديدة</a>
                </div>
            </article>
        </section>
    }
</section>
