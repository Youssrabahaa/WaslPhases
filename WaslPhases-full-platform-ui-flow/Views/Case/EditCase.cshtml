@model phase_1.BLL.DTOs.UpdateCaseDTO
@{
    ViewData["Title"] = "تعديل الحالة";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">تعديل الحالة</span>
            <h1 class="health-title">تعديل بيانات الحالة</h1>
        </div>
        <div class="hero-actions">
            <a class="ghost-action"
               asp-controller="Case"
               asp-action="CaseDetails"
               asp-route-id="@Model.Id"
               asp-route-portal="@portalRoute">← العودة</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert-soft-danger">@TempData["Error"]</div>
    }

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>تعديل البيانات</h2>
                        <p>يمكنك تعديل الحالة فقط إذا كانت مفتوحة.</p>
                    </div>
                </div>

                <form asp-action="EditCase" asp-controller="Case" asp-route-portal="@portalRoute" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group">
                        <label asp-for="Title">عنوان الحالة</label>
                        <input asp-for="Title" class="modern-input" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">وصف الحالة</label>
                        <textarea asp-for="Description" class="modern-input" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="info-grid">
                        <div class="form-group">
                            <label asp-for="ServiceTypeId">نوع الخدمة</label>
                            <select asp-for="ServiceTypeId" class="modern-input">
                                <option value="1">زيارة منزلية</option>
                                <option value="2">داخل العيادة</option>
                                <option value="3">متابعة أونلاين</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label asp-for="TreatmentCategoryId">التصنيف</label>
                            <select asp-for="TreatmentCategoryId" class="modern-input">
                                <option value="1">طب أسنان الأطفال</option>
                                <option value="2">طب تحفظي</option>
                                <option value="3">جراحة الفم</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label asp-for="Urgency">الأولوية</label>
                            <select asp-for="Urgency" class="modern-input">
                                <option value="1">منخفضة</option>
                                <option value="2">متوسطة</option>
                                <option value="3">عالية</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label asp-for="Governorate">المحافظة</label>
                            <input asp-for="Governorate" class="modern-input" />
                        </div>

                        <div class="form-group">
                            <label asp-for="City">المدينة</label>
                            <input asp-for="City" class="modern-input" />
                        </div>

                        <div class="form-group">
                            <label asp-for="Area">الحي</label>
                            <input asp-for="Area" class="modern-input" />
                        </div>

                        <div class="form-group">
                            <label asp-for="EstimatedPriceMin">الحد الأدنى (ج.م)</label>
                            <input asp-for="EstimatedPriceMin" class="modern-input" type="number" />
                        </div>

                        <div class="form-group">
                            <label asp-for="EstimatedPriceMax">الحد الأقصى (ج.م)</label>
                            <input asp-for="EstimatedPriceMax" class="modern-input" type="number" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            <input asp-for="NeedsSupervisorApproval" type="checkbox" />
                            يحتاج إشراف مشرف
                        </label>
                    </div>

                    <div class="form-actions mt-4">
                        <button type="submit" class="primary-action">حفظ التعديلات</button>
                        <a class="ghost-action"
                           asp-controller="Case"
                           asp-action="CaseDetails"
                           asp-route-id="@Model.Id"
                           asp-route-portal="@portalRoute">إلغاء</a>
                    </div>
                </form>
            </article>
        </section>
    </div>
</section>
