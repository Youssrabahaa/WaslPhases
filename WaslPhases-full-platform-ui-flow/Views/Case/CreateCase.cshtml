@model phase_1.BLL.DTOs.CreateCaseDTO
@{
    ViewData["Title"] = "نشر حالة جديدة";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">نشر حالة</span>
            <h1 class="health-title">أضف حالتك الطبية</h1>
            <p class="health-subtitle">صف حالتك بوضوح وستصلك عروض من طلاب الأسنان المناسبين.</p>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>بيانات الحالة</h2>
                        <p>أدخل تفاصيل حالتك الطبية.</p>
                    </div>
                </div>

                <form asp-action="CreateCase" asp-controller="Case" asp-route-portal="@portalRoute" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PatientUserId" />

                    <div class="form-group">
                        <label asp-for="Title">عنوان الحالة</label>
                        <input asp-for="Title" class="modern-input" placeholder="مثال: علاج تسوس أسنان لطفل" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">وصف الحالة</label>
                        <textarea asp-for="Description" class="modern-input" rows="4"
                                  placeholder="اشرح حالتك بتفصيل..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="info-grid">
                        <div class="form-group">
                            <label asp-for="ServiceTypeId">نوع الخدمة</label>
                            <select asp-for="ServiceTypeId" class="modern-input">
                                <option value="">-- اختر --</option>
                                <option value="1">زيارة منزلية</option>
                                <option value="2">داخل العيادة</option>
                                <option value="3">متابعة أونلاين</option>
                            </select>
                            <span asp-validation-for="ServiceTypeId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="TreatmentCategoryId">التصنيف</label>
                            <select asp-for="TreatmentCategoryId" class="modern-input">
                                <option value="">-- اختر --</option>
                                <option value="1">طب أسنان الأطفال</option>
                                <option value="2">طب تحفظي</option>
                                <option value="3">جراحة الفم</option>
                            </select>
                            <span asp-validation-for="TreatmentCategoryId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Urgency">الأولوية</label>
                            <select asp-for="Urgency" class="modern-input">
                                <option value="1">منخفضة</option>
                                <option value="2" selected>متوسطة</option>
                                <option value="3">عالية</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label asp-for="Governorate">المحافظة</label>
                            <input asp-for="Governorate" class="modern-input" placeholder="القاهرة" />
                            <span asp-validation-for="Governorate" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="City">المدينة</label>
                            <input asp-for="City" class="modern-input" placeholder="مدينة نصر" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Area">الحي</label>
                            <input asp-for="Area" class="modern-input" placeholder="الحي السابع" />
                            <span asp-validation-for="Area" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="EstimatedPriceMin">الحد الأدنى للسعر (ج.م)</label>
                            <input asp-for="EstimatedPriceMin" class="modern-input" type="number" placeholder="150" />
                        </div>

                        <div class="form-group">
                            <label asp-for="EstimatedPriceMax">الحد الأقصى للسعر (ج.م)</label>
                            <input asp-for="EstimatedPriceMax" class="modern-input" type="number" placeholder="300" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            <input asp-for="NeedsSupervisorApproval" type="checkbox" />
                            يحتاج إشراف مشرف
                        </label>
                    </div>

                    <div class="form-actions mt-4">
                        <button type="submit" class="primary-action">نشر الحالة</button>
                        <a class="ghost-action"
                           asp-controller="Case"
                           asp-action="MyCases"
                           asp-route-portal="@portalRoute">إلغاء</a>
                    </div>
                </form>
            </article>
        </section>
    </div>
</section>