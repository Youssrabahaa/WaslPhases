@model phase_1.BLL.DTOs.CreateCaseDTO
@{
    ViewData["Title"] = "نشر حالة جديدة";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">نشر حالة</span>
            <h1 class="health-title">أضف حالتك الطبية</h1>
            <p class="health-subtitle">صف حالتك بوضوح وستصلك عروض من طلاب الأسنان المناسبين.</p>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>بيانات الحالة</h2>
                        <p>أدخل تفاصيل حالتك الطبية.</p>
                    </div>
                </div>

                <form asp-action="CreateCase" asp-controller="Case" asp-route-portal="@portalRoute" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PatientUserId" />

                    <div class="form-group">
                        <label asp-for="Title">عنوان الحالة</label>
                        <input asp-for="Title" id="Title" class="modern-input" placeholder="مثال: علاج تسوس أسنان لطفل" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">وصف الحالة</label>
                        <textarea asp-for="Description" id="Description" class="modern-input" rows="4"
                                  placeholder="اشرح حالتك بتفصيل... إيه اللي حاسس بيه؟"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="ai-assist-card">
                        <div class="ai-assist-header">
                            <span class="ai-assist-avatar">🤖</span>
                            <div>
                                <strong>مساعد وصل الذكي</strong>
                                <p>اكتبي وصف حالتك فوق، وهو هيقترحلك اسم مناسب للحالة تحطيه في العنوان.</p>
                            </div>
                        </div>

                        <button type="button" id="suggest-title-btn" class="ai-assist-btn">
                            <span class="ai-assist-btn-icon">🪄</span>
                            <span id="suggest-title-btn-label">اقترح اسم الحالة</span>
                        </button>

                        <div id="suggest-title-status" class="ai-assist-status"></div>

                        <div id="suggest-title-result" class="ai-assist-result" style="display:none;">
                            <span class="ai-assist-bubble-icon">🤖</span>
                            <div class="ai-assist-bubble">
                                <span id="suggest-title-text"></span>
                                <small>✅ اتحط في خانة عنوان الحالة، وتقدري تعدليه قبل النشر.</small>
                            </div>
                        </div>
                    </div>

                    <div class="info-grid">
                        <div class="form-group">
                            <label asp-for="ServiceTypeId">نوع الخدمة</label>
                            <select asp-for="ServiceTypeId" class="modern-input">
                                <option value="">-- اختر --</option>
                                <option value="1">زيارة منزلية</option>
                                <option value="2">داخل العيادة</option>
                                <option value="3">متابعة أونلاين</option>
                            </select>
                            <span asp-validation-for="ServiceTypeId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="TreatmentCategoryId">التصنيف</label>
                            <select asp-for="TreatmentCategoryId" class="modern-input">
                                <option value="">-- اختر --</option>
                                <option value="1">طب أسنان الأطفال</option>
                                <option value="2">طب تحفظي</option>
                                <option value="3">جراحة الفم</option>
                            </select>
                            <span asp-validation-for="TreatmentCategoryId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Urgency">الأولوية</label>
                            <select asp-for="Urgency" class="modern-input">
                                <option value="1">منخفضة</option>
                                <option value="2" selected>متوسطة</option>
                                <option value="3">عالية</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label asp-for="Governorate">المحافظة</label>
                            <input asp-for="Governorate" class="modern-input" placeholder="القاهرة" />
                            <span asp-validation-for="Governorate" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="City">المدينة</label>
                            <input asp-for="City" class="modern-input" placeholder="مدينة نصر" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Area">الحي</label>
                            <input asp-for="Area" class="modern-input" placeholder="الحي السابع" />
                            <span asp-validation-for="Area" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="EstimatedPriceMin">الحد الأدنى للسعر (ج.م)</label>
                            <input asp-for="EstimatedPriceMin" class="modern-input" type="number" placeholder="150" />
                        </div>

                        <div class="form-group">
                            <label asp-for="EstimatedPriceMax">الحد الأقصى للسعر (ج.م)</label>
                            <input asp-for="EstimatedPriceMax" class="modern-input" type="number" placeholder="300" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            <input asp-for="NeedsSupervisorApproval" type="checkbox" />
                            يحتاج إشراف مشرف
                        </label>
                    </div>

                    <div class="form-actions mt-4">
                        <button type="submit" class="primary-action">نشر الحالة</button>
                        <a class="ghost-action"
                           asp-controller="Case"
                           asp-action="MyCases"
                           asp-route-portal="@portalRoute">إلغاء</a>
                    </div>
                </form>
            </article>
        </section>
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('suggest-title-btn').addEventListener('click', async function () {
            var description = document.getElementById('Description').value.trim();
            var statusEl = document.getElementById('suggest-title-status');
            var resultEl = document.getElementById('suggest-title-result');
            var textEl = document.getElementById('suggest-title-text');
            var labelEl = document.getElementById('suggest-title-btn-label');
            var btn = this;

            statusEl.classList.remove('is-error');
            resultEl.style.display = 'none';

            if (!description) {
                statusEl.textContent = 'اكتبي وصف الحالة الأول.';
                statusEl.classList.add('is-error');
                return;
            }

            btn.disabled = true;
            labelEl.textContent = 'بيفكر...';
            btn.insertAdjacentHTML('afterbegin', '<span class="ai-assist-spinner" id="suggest-title-spinner"></span>');
            statusEl.textContent = '';

            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var response = await fetch('@Url.Action("SuggestCaseTitle", "Case")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ description: description, __RequestVerificationToken: token })
                });

                var data = await response.json();

                if (!response.ok) {
                    statusEl.textContent = data.message || 'تعذر الحصول على اقتراح.';
                    statusEl.classList.add('is-error');
                    return;
                }

                document.getElementById('Title').value = data.title;
                textEl.textContent = data.title;
                resultEl.style.display = 'flex';
            } catch (e) {
                statusEl.textContent = 'حدث خطأ أثناء الاتصال، حاول مرة أخرى.';
                statusEl.classList.add('is-error');
            } finally {
                btn.disabled = false;
                labelEl.textContent = 'اقترح اسم الحالة';
                var spinner = document.getElementById('suggest-title-spinner');
                if (spinner) spinner.remove();
            }
        });
    </script>
}