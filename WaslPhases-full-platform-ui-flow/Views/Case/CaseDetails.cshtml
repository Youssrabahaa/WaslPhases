@model phase_1.BLL.DTOs.CaseDetailsDTO
@{
    ViewData["Title"] = "تفاصيل الحالة";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();

    // ✅ UI Auth
    var uid      = Context.Session.GetInt32("UserId") ?? 0;
    var role     = Context.Session.GetInt32("UserRole") ?? 0;
    var isPatient = role == 1;
    var isStudent = role == 2;
    var ownsCase  = uid == Model.PatientUserId;

    var statusClass = Model.Status == 1 ? "status-inprogress"
                    : Model.Status == 2 ? "status-completed"
                    : "status-rejected";
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">تفاصيل الحالة</span>
            <h1 class="health-title">@Model.Title</h1>
            <p class="health-subtitle">@Model.TreatmentCategoryName — @Model.Governorate</p>
        </div>
        <div class="hero-actions">
            @* ✅ تعديل: المريض صاحب الحالة + Open فقط *@
            @if (isPatient && ownsCase && Model.Status == 1)
            {
                <a class="ghost-action"
                   asp-controller="Case"
                   asp-action="EditCase"
                   asp-route-id="@Model.Id"
                   asp-route-portal="@portalRoute">تعديل</a>
            }

            @* ✅ تقديم عرض: الطالب فقط + Open فقط *@
            @if (isStudent && Model.Status == 1)
            {
                <a class="primary-action"
                   asp-controller="Offer"
                   asp-action="CreateOffer"
                   asp-route-caseId="@Model.Id"
                   asp-route-portal="@portalRoute">تقديم عرض</a>
            }

            <a class="ghost-action"
               asp-controller="Case"
               asp-action="MyCases"
               asp-route-portal="@portalRoute">← العودة</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="app-toast"><span class="app-toast-dot"></span>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-soft-danger">@TempData["Error"]</div>
    }

    <div class="metric-strip">
        <article class="mini-kpi">
            <span class="mini-kpi-label">الحالة</span>
            <strong><span class="status-badge @statusClass">@Model.StatusText</span></strong>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">العروض</span>
            <strong>@Model.OffersCount عرض</strong>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">الأولوية</span>
            <strong>@(Model.Urgency == 1 ? "منخفضة" : Model.Urgency == 2 ? "متوسطة" : "عالية")</strong>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">النشر</span>
            <strong>@Model.CreatedAt.ToString("dd MMM yyyy")</strong>
        </article>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div><h2>بيانات الحالة</h2></div>
                    <span class="status-badge @statusClass">@Model.StatusText</span>
                </div>
                <div class="info-grid">
                    <div class="info-block">
                        <span>المريض</span>
                        <strong>@Model.PatientName</strong>
                    </div>
                    <div class="info-block">
                        <span>نوع الخدمة</span>
                        <strong>@Model.ServiceTypeName</strong>
                    </div>
                    <div class="info-block">
                        <span>التصنيف</span>
                        <strong>@Model.TreatmentCategoryName</strong>
                    </div>
                    <div class="info-block">
                        <span>الموقع</span>
                        <strong>@Model.Governorate — @Model.City — @Model.Area</strong>
                    </div>
                    <div class="info-block">
                        <span>السعر المتوقع</span>
                        <strong>
                            @(Model.EstimatedPriceMin?.ToString("N0") ?? "—") —
                            @(Model.EstimatedPriceMax?.ToString("N0") ?? "—") ج.م
                        </strong>
                    </div>
                    <div class="info-block">
                        <span>إشراف مشرف</span>
                        <strong>@(Model.NeedsSupervisorApproval ? "مطلوب" : "غير مطلوب")</strong>
                    </div>
                </div>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <div><h2>وصف الحالة</h2></div>
                </div>
                <p class="body-copy">@Model.Description</p>
            </article>

            @* ✅ العروض: المريض صاحب الحالة فقط يشوف ويقبل *@
            @if (isPatient && ownsCase && Model.Offers.Any())
            {
                <article class="health-panel">
                    <div class="panel-heading">
                        <div>
                            <h2>العروض الواردة (@Model.OffersCount)</h2>
                            <p>اختر العرض المناسب لك وتواصل مع الطالب.</p>
                        </div>
                    </div>
                    <div class="offer-list">
                        @foreach (var offer in Model.Offers)
                        {
                            
                                var oText  = offer.Status == 1 ? "قيد المراجعة"
                                           : offer.Status == 2 ? "مقبول" : "مرفوض";
                                var oCls   = offer.Status == 1 ? "status-pending"
                                           : offer.Status == 2 ? "status-open" : "status-rejected";
                            
                            <article class="session-card">
                                <div>
                                    <div class="case-card-top">
                                        <span class="status-badge @oCls">@oText</span>
                                    </div>
                                    <h4>@offer.StudentName</h4>
                                    <p class="case-meta">
                                        @(offer.ProposedPrice?.ToString("N0") ?? "—") ج.م —
                                        @(offer.EstimatedSessionsCount?.ToString() ?? "—") جلسة
                                    </p>
                                    @if (!string.IsNullOrEmpty(offer.Message))
                                    {
                                        <p class="body-copy mt-2">@offer.Message</p>
                                    }

                                    @* ✅ قبول/رفض: المريض صاحب الحالة + Pending + Case Open *@
                                    @if (offer.Status == 1 && Model.Status == 1)
                                    {
                                        <div class="row-actions mt-3">
                                            <form asp-controller="Match"
                                                  asp-action="AcceptOffer"
                                                  asp-route-portal="@portalRoute"
                                                  method="post" style="display:inline;"
                                                  onsubmit="return confirm('هل تريد قبول هذا العرض؟')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="offerId" value="@offer.Id" />
                                                <input type="hidden" name="caseId"  value="@Model.Id" />
                                                <button type="submit" class="primary-action compact-action">قبول</button>
                                            </form>

                                            <form asp-controller="Offer"
                                                  asp-action="RejectOffer"
                                                  asp-route-portal="@portalRoute"
                                                  method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@offer.Id" />
                                                <button type="submit" class="danger-action compact-action">رفض</button>
                                            </form>
                                        </div>
                                    }
                                </div>
                                <div class="card-side">
                                    <strong>@(offer.ProposedPrice?.ToString("N0") ?? "—") ج.م</strong>
                                    <span class="case-meta">@offer.CreatedAt.ToString("dd MMM")</span>
                                </div>
                            </article>
                        }
                    </div>
                </article>
            }
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div><h2>إجراءات</h2></div>
                </div>
                <div class="action-list">
                    @* ✅ تقديم عرض: الطالب فقط *@
                    @if (isStudent && Model.Status == 1)
                    {
                        <a class="action-tile"
                           asp-controller="Offer"
                           asp-action="CreateOffer"
                           asp-route-caseId="@Model.Id"
                           asp-route-portal="@portalRoute">
                            <strong>تقديم عرض</strong>
                            <span>أرسل عرضك لهذه الحالة.</span>
                        </a>
                    }
                    @* ✅ تعديل: المريض صاحب الحالة فقط *@
                    @if (isPatient && ownsCase && Model.Status == 1)
                    {
                        <a class="action-tile"
                           asp-controller="Case"
                           asp-action="EditCase"
                           asp-route-id="@Model.Id"
                           asp-route-portal="@portalRoute">
                            <strong>تعديل الحالة</strong>
                            <span>عدّل بيانات حالتك.</span>
                        </a>
                    }
                </div>
            </article>
        </aside>
    </div>
</section>

