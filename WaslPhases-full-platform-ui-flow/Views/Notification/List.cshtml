@model List<phase_1.BLL.DTOs.NotificationDTO>
@{
    ViewData["Title"] = "الإشعارات";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
    var unread = Model.Count(n => !n.IsRead);
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">الإشعارات</span>
            <h1 class="health-title">
                كل التنبيهات
                @if (unread > 0)
                {
                    <span class="status-badge status-inprogress">@unread جديد</span>
                }
            </h1>
        </div>
        <div class="hero-actions">
            @if (unread > 0)
            {
                <form asp-action="MarkAllAsRead" asp-controller="Notification"
                      asp-route-portal="@portalRoute" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ghost-action">تعليم الكل كمقروء</button>
                </form>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="app-toast"><span class="app-toast-dot"></span>@TempData["Success"]</div>
    }

    <div class="content-main">
        @if (Model.Any())
        {
            <div class="notification-list">
                @foreach (var n in Model)
                {
                    
                        var icon = n.Type switch
                        {
                            1 => "✅",
                            2 => "❌",
                            3 => "🤝",
                            4 => "💬",
                            5 => "📅",
                            6 => "⏰",
                            _ => "🔔"
                        };

                        var linkController = n.ReferenceType switch
                        {
                            "Match"   => "Match",
                            "Session" => "Session",
                            "Offer"   => "Offer",
                            _         => "Match"
                        };
                        var linkAction = n.ReferenceType switch
                        {
                            "Match"   => "MatchDetails",
                            "Session" => "SessionDetails",
                            "Offer"   => "OfferDetails",
                            _         => "Index"
                        };
                    
                    <article class="notification-item @(!n.IsRead ? "unread" : "")"
                             style="@(!n.IsRead ? "border-right: 3px solid var(--teal); background: rgba(20,184,166,0.04);" : "")">
                        <span style="font-size:1.4rem; min-width: 2rem;">@icon</span>
                        <div style="flex:1;">
                            <strong>@n.Title</strong>
                            <p class="case-meta" style="margin:0.2rem 0;">@n.Message</p>
                            <time class="case-meta">@n.TimeAgo</time>
                        </div>
                        <div style="display:flex; gap:0.5rem; align-items:center;">
                            @if (n.ReferenceId.HasValue)
                            {
                                <a class="ghost-action compact-action"
                                   asp-controller="@linkController"
                                   asp-action="@linkAction"
                                   asp-route-id="@n.ReferenceId"
                                   asp-route-portal="@portalRoute">عرض</a>
                            }
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkAsRead" asp-controller="Notification"
                                      asp-route-portal="@portalRoute"
                                      method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@n.Id" />
                                    <button type="submit" class="compact-action"
                                            style="background:none; border:none; color:var(--teal); cursor:pointer; font-size:0.8rem;">
                                        ✓ مقروء
                                    </button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <section class="state-grid">
                <article class="empty-state-card">
                    <span class="empty-state-icon">🔔</span>
                    <h3>لا توجد إشعارات</h3>
                    <p>ستظهر التنبيهات هنا عند قبول عرض أو تحديد جلسة.</p>
                </article>
            </section>
        }
    </div>
</section>
