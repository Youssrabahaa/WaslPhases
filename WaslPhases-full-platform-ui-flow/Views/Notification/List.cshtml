@{
    ViewData["Title"] = "الإشعارات";
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">الإشعارات</span>
            <h1 class="health-title">كل التنبيهات المهمة في مكان واحد.</h1>
            <p class="health-subtitle">قائمة مركزة تعرض الجديد والمهم، مع حالة قراءة واضحة لكل إشعار.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action" asp-controller="Home" asp-action="Index">الرئيسية</a>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <div class="notification-list">
                <article class="notification-item unread">
                    <span class="notification-glow"></span>
                    <div>
                        <strong>تم قبول عرض جديد</strong>
                        <p>تم تحويل العرض إلى مطابقة ويمكنك الآن متابعة الجلسات.</p>
                    </div>
                    <time>منذ 12 دقيقة</time>
                </article>

                <article class="notification-item unread">
                    <span class="notification-glow"></span>
                    <div>
                        <strong>كود تحقق جديد</strong>
                        <p>تم إرسال رمز التحقق إلى رقم الهاتف المسجل.</p>
                    </div>
                    <time>منذ ساعة</time>
                </article>

                <article class="notification-item">
                    <span class="notification-glow"></span>
                    <div>
                        <strong>تقرير قيد المراجعة</strong>
                        <p>تم إرسال تقرير الجلسة للمشرف وينتظر القرار.</p>
                    </div>
                    <time>أمس</time>
                </article>
            </div>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>تعليم الإشعارات</h2>
                        <p>إجراء سريع لتجربة حالة القراءة داخل الواجهة.</p>
                    </div>
                </div>
                <form>
                    <button type="button" class="primary-action loading-button">
                        <span class="button-label">تعليم كمقروء</span>
                        <span class="button-loader"></span>
                    </button>
                </form>
            </article>

            @await Html.PartialAsync("_EmptyState")
        </aside>
    </div>
</section>
