@using phase_1.BLL.DTOs
@model List<SessionDTO>
@{
    ViewData["Title"] = "قائمة الجلسات";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString() ?? "student";
    var matchId = ViewBag.MatchId as int? ?? 0;

    //  إصلاح: Role متحفظ كـ int في Session مش string
    var userRole = Context.Session.GetInt32("UserRole") ?? 0;
    var isStudent = userRole == 2;
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">الجلسات</span>
            <h1 class="health-title">إدارة الجلسات</h1>
            <p class="health-subtitle">قائمة الجلسات المرتبطة بالمطابقة — بدء، إنهاء، أو إلغاء.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action"
               asp-controller="Match"
               asp-action="MatchDetails"
               asp-route-id="@matchId"
               asp-route-portal="@portalRoute">← تفاصيل المطابقة</a>

            @*  إصلاح: يظهر للطالب فقط (Role=2) *@
            @if (isStudent && matchId > 0)
            {
                <a class="primary-action"
                   asp-controller="Session"
                   asp-action="AddSession"
                   asp-route-matchId="@matchId"
                   asp-route-portal="@portalRoute">+ إضافة جلسة</a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="app-toast"><span class="app-toast-dot"></span>@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-soft-danger">@TempData["ErrorMessage"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="offer-list">
            @foreach (var session in Model)
            {
                
                    var statusClass = session.Status == 1 ? "status-inprogress"
                                    : session.Status == 2 ? "status-inprogress"
                                    : session.Status == 3 ? "status-completed"
                                    : "status-rejected";
                
                <article class="session-card">
                    <div>
                        <div class="case-card-top">
                            <span class="status-badge @statusClass">@session.StatusText</span>
                            <span class="case-meta">جلسة @session.Number</span>
                            @if (!string.IsNullOrEmpty(session.ClinicRoom))
                            {
                                <span class="case-meta">غرفة @session.ClinicRoom</span>
                            }
                        </div>
                        <h3>جلسة رقم @session.Number</h3>
                        <p class="case-meta">
                            @(!string.IsNullOrEmpty(session.LocationText) ? session.LocationText : "العيادة")
                        </p>
                        <div class="row-actions mt-3">
                            <a class="primary-action compact-action"
                               asp-controller="Session"
                               asp-action="SessionDetails"
                               asp-route-id="@session.Id"
                               asp-route-portal="@portalRoute">تفاصيل</a>

                            @if (session.Status == 1)
                            {
                                <form asp-action="Start" asp-controller="Session"
                                      asp-route-portal="@portalRoute"
                                      method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@session.Id" />
                                    <button type="submit" class="ghost-action compact-action">بدء</button>
                                </form>
                            }
                            else if (session.Status == 2)
                            {
                                <form asp-action="Finish" asp-controller="Session"
                                      asp-route-portal="@portalRoute"
                                      method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@session.Id" />
                                    <button type="submit" class="ghost-action compact-action">إنهاء</button>
                                </form>
                            }

                            @if (session.Status != 3)
                            {
                                <form asp-action="Cancel" asp-controller="Session"
                                      asp-route-portal="@portalRoute"
                                      method="post" style="display:inline;"
                                      onsubmit="return confirm('هل تريد إلغاء هذه الجلسة؟')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@session.Id" />
                                    <input type="hidden" name="matchId" value="@session.MatchId" />
                                    <button type="submit" class="danger-action compact-action">إلغاء</button>
                                </form>
                            }
                        </div>
                    </div>
                    <div class="card-side">
                        <strong>@session.StartAt.ToString("dd/MM/yyyy")</strong>
                        <span class="case-meta">@session.StartAt.ToString("hh:mm tt")</span>
                        <span class="case-meta">@session.StatusText</span>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <section class="state-grid">
            <article class="empty-state-card">
                <span class="empty-state-icon">📅</span>
                <h3>لا توجد جلسات</h3>
                <p>لا توجد جلسات مرتبطة بهذه المطابقة بعد.</p>
                @if (isStudent && matchId > 0)
                {
                    <div class="mt-3">
                        <a class="primary-action"
                           asp-controller="Session"
                           asp-action="AddSession"
                           asp-route-matchId="@matchId"
                           asp-route-portal="@portalRoute">إضافة جلسة جديدة</a>
                    </div>
                }
            </article>
        </section>
    }
</section>
