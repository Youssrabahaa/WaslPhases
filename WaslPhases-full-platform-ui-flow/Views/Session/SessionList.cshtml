@using phase_1.BLL.DTOs
@model List<SessionDTO>
@{
    ViewData["Title"] = "قائمة الجلسات";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString() ?? "student";
    var matchId = ViewBag.MatchId ?? 0;
    var userRole = Context.Session.GetInt32("UserRole") ?? 0;
    var isPatient = userRole == 1;
    var isStudent = userRole == 2;
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">الجلسات</span>
            <h1 class="health-title">إدارة الجلسات بوضوح من البداية للنهاية.</h1>
            <p class="health-subtitle">قائمة الجلسات تعرض المواعيد، الحالات، وإجراءات البدء أو المتابعة مع حالة عدم وجود جلسات.</p>
        </div>
        <div class="hero-actions">
            @if (matchId > 0)
            {
                <a class="primary-action" asp-controller="Match" asp-action="MatchDetails" asp-route-portal="@portalRoute" asp-route-id="@matchId">تفاصيل المطابقة</a>
            }
            @* ✅ إضافة جلسة: للمريض فقط ويجب أن يكون matchId محدداً *@
            @if (matchId > 0 && isPatient)
            {
                <a class="primary-action"
                   asp-controller="Session"
                   asp-action="AddSession"
                   asp-route-portal="@portalRoute"
                   asp-route-matchId="@matchId"
                   style="background-color: #10b981;">
                    ➕ إضافة جلسة
                </a>
            }
            <a class="ghost-action" asp-controller="Home" asp-action="Index" asp-route-portal="@portalRoute">الرئيسية</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="app-toast"><span class="app-toast-dot"></span>@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-soft-danger">@TempData["ErrorMessage"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="offer-list">
            @foreach (var session in Model)
            {
                @{
                    var statusClass = session.Status == 1 ? "status-scheduled" :
                                     session.Status == 2 ? "status-inprogress" :
                                     session.Status == 3 ? "status-completed" :
                                     "status-cancelled";
                }
                <article class="session-card">
                    <div>
                        <div class="case-card-top">
                            <span class="status-badge @statusClass">@session.StatusText</span>
                            <span class="case-meta">الجلسة @session.Number</span>
                            @if (!string.IsNullOrEmpty(session.ClinicRoom))
                            {
                                <span class="case-meta">غرفة @session.ClinicRoom</span>
                            }
                        </div>
                        <h3>جلسة @session.Number</h3>
                        <p>@(!string.IsNullOrEmpty(session.LocationText) ? session.LocationText : "العيادة")</p>
                        <div class="row-actions mt-3">
                            <a class="primary-action compact-action"
                               asp-controller="Session"
                               asp-action="SessionDetails"
                               asp-route-id="@session.Id"
                               asp-route-portal="@portalRoute">تفاصيل الجلسة</a>

                            @* ✅ بدء الجلسة: للطالب فقط عند Scheduled *@
                            @if (session.Status == 1 && isStudent)
                            {
                                <form asp-action="Start" asp-controller="Session" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@session.Id" />
                                    <button type="submit" class="primary-action compact-action" style="background-color: #f59e0b;">▶ بدء الجلسة</button>
                                </form>
                            }

                            @* ✅ فتح الشات: للمريض والطالب عند InProgress *@
                            @if (session.Status == 2)
                            {
                                <a class="primary-action compact-action"
                                   asp-controller="Conversation"
                                   asp-action="Chat"
                                   asp-route-matchId="@session.MatchId"
                                   asp-route-portal="@portalRoute"
                                   style="background: linear-gradient(135deg, var(--teal), var(--blue));">💬 الشات</a>

                                @* ✅ إنهاء الجلسة: للطالب فقط *@
                                @if (isStudent)
                                {
                                    <form asp-action="Finish" asp-controller="Session" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@session.Id" />
                                        <button type="submit" class="ghost-action compact-action" style="background-color: #10b981; color: white; border: none;">✓ إنهاء</button>
                                    </form>
                                }
                            }

                            @* ✅ إلغاء الجلسة: للمريض فقط وعند Scheduled فقط (Status==1) *@
                            @if (session.Status == 1 && isPatient)
                            {
                                <form asp-action="Cancel" asp-controller="Session" method="post" style="display:inline;"
                                      onsubmit="return confirm('هل أنت متأكد من إلغاء الجلسة؟')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@session.Id" />
                                    <input type="hidden" name="matchId" value="@session.MatchId" />
                                    <button type="submit" class="danger-action compact-action">✕ إلغاء</button>
                                </form>
                            }
                        </div>
                    </div>
                    <div class="card-side">
                        <strong>@session.StartAt.ToString("dd/MM/yyyy h:mm tt")</strong>
                        <span class="case-meta">
                            @(session.Status == 1 ? "مجدولة" :
                                session.Status == 2 ? "قيد التنفيذ" :
                                session.Status == 3 ? "مكتملة" : "ملغية")
                        </span>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <section class="state-grid">
            <article class="empty-state-card">
                <span class="empty-state-icon">📅</span>
                <h3>لا توجد جلسات</h3>
                <p>لا توجد جلسات مرتبطة بهذه المطابقة بعد. عند قبول العرض وتحديد موعد ستظهر هنا.</p>
                @if (matchId > 0 && isPatient)
                {
                    <div class="mt-3">
                        <a class="primary-action"
                           asp-controller="Session"
                           asp-action="AddSession"
                           asp-route-portal="@portalRoute"
                           asp-route-matchId="@matchId">إضافة جلسة جديدة</a>
                    </div>
                }
            </article>
        </section>
    }
</section>
