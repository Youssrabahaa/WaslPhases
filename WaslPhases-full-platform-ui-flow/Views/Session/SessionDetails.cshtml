@{
    ViewData["Title"] = "تفاصيل الجلسة";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">Session Details</span>
            <h1 class="health-title">جلسة رقم 1</h1>
            <p class="health-subtitle">تفاصيل الجلسة، حالتها، ومكانها مع إجراءات البدء والإنهاء.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action" asp-controller="Session" asp-action="SessionList" asp-route-portal="@portalRoute">كل الجلسات</a>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>بيانات الجلسة</h2>
                        <p>تفاصيل عملية تساعد على متابعة موعد الجلسة ومكانها.</p>
                    </div>
                    <span class="status-badge status-inprogress">Session in progress</span>
                </div>
                <div class="info-grid">
                    <div class="info-block">
                        <span>الموعد</span>
                        <strong>29 أبريل 2026 - 5:00 م</strong>
                    </div>
                    <div class="info-block">
                        <span>المكان</span>
                        <strong>Kasr Al-Ainy Clinic</strong>
                    </div>
                    <div class="info-block">
                        <span>الغرفة</span>
                        <strong>C-12</strong>
                    </div>
                    <div class="info-block">
                        <span>المشرف</span>
                        <strong>د. هالة سمير</strong>
                    </div>
                </div>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>ملاحظات الجلسة</h2>
                        <p>مساحة تجهيز للتقرير النهائي بعد انتهاء الجلسة.</p>
                    </div>
                </div>
                <p class="body-copy">تم بدء الجلسة، والتقييم الأولي يشير إلى احتياج المريض لجلسة متابعة بعد أسبوع مع تعليمات وقائية قصيرة.</p>
            </article>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>حالة التنفيذ</h2>
                        <p>أزرار lifecycle للجلسة.</p>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="primary-action loading-button">
                        <span class="button-label">بدء الجلسة</span>
                        <span class="button-loader"></span>
                    </button>
                    <button type="button" class="ghost-action">إنهاء الجلسة</button>
                    <a class="soft-action" asp-controller="Report" asp-action="AddReport" asp-route-portal="@portalRoute">إضافة تقرير</a>
                </div>
            </article>
        </aside>
    </div>
</section>
