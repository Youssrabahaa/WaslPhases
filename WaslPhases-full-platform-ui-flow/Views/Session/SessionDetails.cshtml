@using phase_1.BLL.DTOs
@model SessionDetailsDTO
@{
    ViewData["Title"] = "تفاصيل الجلسة";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
    var userRole = Context.Session.GetInt32("UserRole") ?? 0;
    var isStudent = userRole == 2;
    var isPatient = userRole == 1;
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">تفاصيل الجلسة</span>
            <h1 class="health-title">جلسة رقم @Model.Number</h1>
            <p class="health-subtitle">@Model.StatusText</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action"
               asp-controller="Session"
               asp-action="SessionList"
               asp-route-matchId="@Model.MatchId"
               asp-route-portal="@portalRoute">كل الجلسات</a>
            <a class="ghost-action"
               asp-controller="Match"
               asp-action="MatchDetails"
               asp-route-id="@Model.MatchId"
               asp-route-portal="@portalRoute">← المطابقة</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="app-toast"><span class="app-toast-dot"></span>@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-soft-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>بيانات الجلسة</h2>
                        <p>تفاصيل عملية تساعد على متابعة موعد الجلسة ومكانها.</p>
                    </div>
                    <span class="status-badge">@Model.StatusText</span>
                </div>
                <div class="info-grid">
                    <div class="info-block">
                        <span>الموعد</span>
                        <strong>@Model.StartAt.ToString("dd/MM/yyyy hh:mm tt")</strong>
                    </div>
                    <div class="info-block">
                        <span>نهاية الجلسة</span>
                        <strong>@Model.EndAt.ToString("dd/MM/yyyy hh:mm tt")</strong>
                    </div>
                    <div class="info-block">
                        <span>المكان</span>
                        <strong>@(string.IsNullOrEmpty(Model.LocationText) ? "—" : Model.LocationText)</strong>
                    </div>
                    <div class="info-block">
                        <span>الغرفة</span>
                        <strong>@(string.IsNullOrEmpty(Model.ClinicRoom) ? "—" : Model.ClinicRoom)</strong>
                    </div>
                    <div class="info-block">
                        <span>المريض</span>
                        <strong>@Model.PatientName</strong>
                    </div>
                    <div class="info-block">
                        <span>الطالب</span>
                        <strong>@Model.StudentName</strong>
                    </div>
                    <div class="info-block">
                        <span>الحالة</span>
                        <strong>@Model.CaseTitle</strong>
                    </div>
                </div>
            </article>
        </section>

        <aside class="content-side">

            <!-- حالة التنفيذ-->
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>حالة التنفيذ</h2>
                        <p>أزرار دورة تنفيذ الجلسة.</p>
                    </div>
                </div>
                <div class="form-actions">
                    @* ✅ بدء الجلسة: للطالب فقط عند Scheduled *@
                    @if (Model.CanStart && isStudent)
                    {
                        <form asp-controller="Session" asp-action="Start" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="primary-action">▶ بدء الجلسة</button>
                        </form>
                    }

                    @* ✅ فتح الشات: للمريض والطالب كليهما — مرتبط بالمطابقة وليس الجلسة *@
                    <a class="primary-action"
                       asp-controller="Conversation"
                       asp-action="Chat"
                       asp-route-matchId="@Model.MatchId"
                       asp-route-portal="@portalRoute"
                       style="background: linear-gradient(135deg, var(--teal), var(--blue));">
                        💬 فتح الشات
                    </a>

                    @* ✅ إنهاء الجلسة: للطالب فقط عند InProgress *@
                    @if (Model.CanFinish && isStudent)
                    {
                        <form asp-controller="Session" asp-action="Finish" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="ghost-action">✓ إنهاء الجلسة</button>
                        </form>
                    }

                    @* ✅ إضافة تقرير: متاح للجميع *@
                    <a class="soft-action" asp-controller="Report" asp-action="AddReport" asp-route-sessionId="@Model.Id" asp-route-portal="@portalRoute">إضافة تقرير</a>

                    @* ✅ إلغاء الجلسة: للمريض فقط — ما لم تكن مكتملة *@
                    @if (isPatient && Model.Status != 3 && Model.Status != 2)
                    {
                        <form asp-controller="Session" asp-action="Cancel" method="post" style="display:inline;"
                              onsubmit="return confirm('هل أنت متأكد من إلغاء الجلسة؟')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="matchId" value="@Model.MatchId" />
                            <button type="submit" class="danger-action">✕ إلغاء الجلسة</button>
                        </form>
                    }
                </div>
            </article>

            <!-- عدم الحضور-->
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>عدم الحضور</h2>
                        <p>تسجيل غياب المريض أو الطالب.</p>
                    </div>
                </div>

                <p>عدد مرات غياب المريض: <strong>@Model.PatientStrikeCount</strong></p>
                <p>عدد مرات غياب الطالب: <strong>@Model.StudentStrikeCount</strong></p>

                @if (Model.NoShowStrike == null)
                {
                    <div class="form-actions mt-3">
                        @* ✅ الطالب يسجل غياب المريض *@
                        @if (isStudent)
                        {
                            <form asp-controller="NoShowStrike" asp-action="Create" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="SessionId" value="@Model.Id" />
                                <input type="hidden" name="ReportedByUserId" value="@Model.StudentUserId" />
                                <input type="hidden" name="AbsentUserId" value="@Model.PatientUserId" />
                                <button type="submit" class="ghost-action">تسجيل غياب المريض</button>
                            </form>
                        }

                        @* ✅ المريض يسجل غياب الطالب *@
                        @if (isPatient)
                        {
                            <form asp-controller="NoShowStrike" asp-action="Create" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="SessionId" value="@Model.Id" />
                                <input type="hidden" name="ReportedByUserId" value="@Model.PatientUserId" />
                                <input type="hidden" name="AbsentUserId" value="@Model.StudentUserId" />
                                <button type="submit" class="ghost-action">تسجيل غياب الطالب</button>
                            </form>
                        }
                    </div>
                }
                else
                {
                    <div class="alert-soft-danger mt-3">
                        <strong>@Model.NoShowStrike.WhoMissed</strong> لم يحضر هذه الجلسة.
                    </div>
                }
            </article>

        </aside>
    </div>
</section>
