@{
    ViewData["Title"] = "تعديل الجلسة";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">تعديل الجلسة</span>
            <h1 class="health-title">تعديل الجلسة رقم 1</h1>
            <p class="health-subtitle">قم بتحديث بيانات الجلسة الحالية مثل الموعد، المكان، أو المشرف.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action" asp-controller="Session" asp-action="SessionList" asp-route-portal="@portalRoute">كل الجلسات</a>
            <!-- أزرار تنقل إضافية -->
             </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>بيانات الجلسة</h2>
                        <p>عدل البيانات الحالية للجلسة.</p>
                    </div>
                    <span class="status-badge status-inprogress">جلسة قيد التنفيذ</span>
                </div>
                <form id="edit-session-form" asp-controller="Session" asp-action="EditSession" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="info-grid" style="grid-template-columns: 1fr 1fr;">
                        <div class="info-block" style="display: flex; flex-direction: column; align-items: start;">
                            <span>الموعد</span>
                            <input name="StartAt" type="datetime-local" value="@Model.StartAt.ToString("yyyy-MM-ddTHH:mm")" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-family: inherit;" />
                        </div>
                        <div class="info-block" style="display: flex; flex-direction: column; align-items: start;">
                            <span>نهاية الجلسة</span>
                            <input name="EndAt" type="datetime-local" value="@Model.EndAt.ToString("yyyy-MM-ddTHH:mm")" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-family: inherit;" />
                        </div>
                        <div class="info-block" style="display: flex; flex-direction: column; align-items: start;">
                            <span>المكان</span>
                            <input name="LocationText" type="text" value="@Model.LocationText" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-family: inherit;" />
                        </div>
                        <div class="info-block" style="display: flex; flex-direction: column; align-items: start;">
                            <span>الغرفة</span>
                            <input name="ClinicRoom" type="text" value="@Model.ClinicRoom" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-family: inherit;" />
                        </div>
                    </div>
                </form>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>ملاحظات الجلسة</h2>
                        <p>عدل الملاحظات المسجلة للجلسة.</p>
                    </div>
                </div>
                <textarea rows="4" style="width: 100%; padding: 12px; border: 1px solid #d1d5db; border-radius: 8px; font-family: inherit; font-size: 1rem;">تم بدء الجلسة، والتقييم الأولي يشير إلى احتياج المريض لجلسة متابعة بعد أسبوع مع تعليمات وقائية قصيرة.</textarea>
            </article>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>إجراءات التعديل</h2>
                        <p>احفظ التعديلات أو ارجع للقائمة.</p>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" form="edit-session-form" class="primary-action">حفظ التعديلات</button>
                    <a class="ghost-action" asp-controller="Session" asp-action="SessionDetails" asp-route-id="@Model.Id" asp-route-portal="@portalRoute">إلغاء</a>
                </div>
            </article>
        </aside>
    </div>
</section>
