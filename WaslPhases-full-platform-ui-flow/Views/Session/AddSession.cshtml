@model phase_1.BLL.DTOs.CreateSessionDTO
@{
    ViewData["Title"] = "إضافة جلسة جديدة";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
    var matchId = Model.MatchId;
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">إضافة جلسة</span>
            <h1 class="health-title">إضافة جلسة جديدة</h1>
            <p class="health-subtitle">أدخل بيانات الجلسة لتحديد موعدها ومكانها.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action"
               asp-controller="Session"
               asp-action="SessionList"
               asp-route-matchId="@matchId"
               asp-route-portal="@portalRoute">← كل الجلسات</a>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>بيانات الجلسة الجديدة</h2>
                        <p>املأ الحقول المطلوبة لإضافة جلسة جديدة.</p>
                    </div>
                </div>

                <form id="add-session-form"
                      asp-controller="Session"
                      asp-action="AddSession"
                      asp-route-portal="@portalRoute"
                      method="post">
                    @Html.AntiForgeryToken()

                    <!-- ✅ hidden fields مطلوبة-->
                    <input type="hidden" asp-for="MatchId" />

                    <div class="info-grid" style="grid-template-columns: 1fr 1fr;">

                        <!-- ✅ Number field مضاف-->
                        <div class="info-block" style="display:flex; flex-direction:column; align-items:start;">
                            <label asp-for="Number">رقم الجلسة</label>
                            <input asp-for="Number"
                                   type="number"
                                   min="1"
                                   class="modern-input"
                                   style="width:100%;"
                                   placeholder="1" />
                            <span asp-validation-for="Number" class="text-danger"></span>
                        </div>

                        <div class="info-block" style="display:flex; flex-direction:column; align-items:start;">
                            <label asp-for="StartAt">موعد البداية</label>
                            <input asp-for="StartAt"
                                   type="datetime-local"
                                   class="modern-input"
                                   style="width:100%;" />
                            <span asp-validation-for="StartAt" class="text-danger"></span>
                        </div>

                        <div class="info-block" style="display:flex; flex-direction:column; align-items:start;">
                            <label asp-for="EndAt">موعد النهاية</label>
                            <input asp-for="EndAt"
                                   type="datetime-local"
                                   class="modern-input"
                                   style="width:100%;" />
                            <span asp-validation-for="EndAt" class="text-danger"></span>
                        </div>

                        <div class="info-block" style="display:flex; flex-direction:column; align-items:start;">
                            <label asp-for="LocationText">المكان</label>
                            <input asp-for="LocationText"
                                   type="text"
                                   class="modern-input"
                                   style="width:100%;"
                                   placeholder="عيادة كلية الأسنان" />
                        </div>

                        <div class="info-block" style="display:flex; flex-direction:column; align-items:start;">
                            <label asp-for="ClinicRoom">رقم الغرفة</label>
                            <input asp-for="ClinicRoom"
                                   type="text"
                                   class="modern-input"
                                   style="width:100%;"
                                   placeholder="غرفة 3" />
                        </div>

                    </div>
                </form>
            </article>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>إجراءات الإضافة</h2>
                        <p>أضف الجلسة أو ارجع للقائمة.</p>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" form="add-session-form" class="primary-action">إضافة الجلسة</button>
                    <a class="ghost-action"
                       asp-controller="Session"
                       asp-action="SessionList"
                       asp-route-matchId="@matchId"
                       asp-route-portal="@portalRoute">إلغاء</a>
                </div>
            </article>
        </aside>
    </div>
</section>

