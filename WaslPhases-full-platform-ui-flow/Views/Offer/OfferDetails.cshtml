@model phase_1.BLL.DTOs.OfferDetailsDTO
@{
    ViewData["Title"] = "تفاصيل العرض";
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">Offer Details</span>
            <h1 class="health-title">تفاصيل العرض رقم @Model.Id</h1>
            <p class="health-subtitle">عرض شامل لبيانات العرض، الحالة، ورسالة الطالب قبل قرار المريض.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action" asp-controller="Offer" asp-action="MyOffers">العودة للعروض</a>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>ملخص العرض</h2>
                        <p>ملخص سريع للسعر، عدد الجلسات، وحالة رد المريض.</p>
                    </div>
                    @if (Model.Status == 1)
                    {
                        <span class="status-badge status-pending">قيد المراجعة</span>
                    }
                    else if (Model.Status == 2)
                    {
                        <span class="status-badge status-open">مقبول</span>
                    }
                    else
                    {
                        <span class="status-badge" style="background-color:#e0e0e0;color:#555;">مرفوض</span>
                    }
                </div>
                <div class="info-grid">
                    <div class="info-block">
                        <span>السعر المقترح</span>
                        <strong>@(Model.ProposedPrice?.ToString() ?? "غير محدد") ج.م</strong>
                    </div>
                    <div class="info-block">
                        <span>عدد الجلسات</span>
                        <strong>@(Model.EstimatedSessionsCount?.ToString() ?? "غير محدد") جلسات</strong>
                    </div>
                    <div class="info-block">
                        <span>تاريخ الإرسال</span>
                        <strong>@Model.CreatedAt.ToString("dd MMMM yyyy")</strong>
                    </div>
                    <div class="info-block">
                        <span>الحالة</span>
                        <strong>
                            @(Model.Status == 1 ? "بانتظار رد المريض" : (Model.Status == 2 ? "تم قبول العرض" : "تم رفض العرض"))
                        </strong>
                    </div>
                </div>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>رسالة الطالب</h2>
                        <p>النص الذي يراه المريض قبل قبول العرض.</p>
                    </div>
                </div>
                <p class="body-copy">@(string.IsNullOrEmpty(Model.Message) ? "لا توجد رسالة مرفقة من الطالب." : Model.Message)</p>
            </article>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>قرار العرض</h2>
                        <p>أزرار جاهزة لمسار المطابقة أو الرفض.</p>
                    </div>
                </div>
                
                @if (Model.Status == 1)
                {
                    <div class="form-actions" style="flex-direction: column;">
                        <form asp-controller="Offer" asp-action="AcceptOffer" asp-route-id="@Model.Id" method="post" style="width:100%;">
                            <button type="submit" class="primary-action loading-button" style="width:100%; justify-content:center;">
                                <span class="button-label">قبول العرض</span>
                            </button>
                        </form>
                        
                        <form asp-controller="Offer" asp-action="RejectOffer" asp-route-id="@Model.Id" method="post" style="width:100%;">
                            <button type="submit" class="danger-action" style="width:100%; justify-content:center; border:none; margin-top:10px;">
                                رفض العرض
                            </button>
                        </form>
                    </div>
                }
                else if (Model.Status == 2)
                {
                    <div class="alert-soft-success">تم قبول هذا العرض! يمكنك الآن متابعة تفاصيل المطابقة.</div>
                    <a class="primary-action" asp-controller="Match" asp-action="MatchDetails" asp-route-id="@Model.Id">الانتقال للمطابقة</a>
                }
                else
                {
                    <div style="padding:15px; background:#ffebeb; color:#d32f2f; border-radius:8px;">تم رفض هذا العرض مسبقاً.</div>
                }
            </article>
        </aside>
    </div>
</section>
