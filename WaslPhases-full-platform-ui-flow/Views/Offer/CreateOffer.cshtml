@{
    ViewData["Title"] = "تقديم عرض";
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">Create Offer</span>
            <h1 class="health-title">قدّم عرض واضح للمريض.</h1>
            <p class="health-subtitle">العرض الجيد يوضح السعر، عدد الجلسات، والخطة المختصرة قبل قبول المريض.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action" asp-controller="Offer" asp-action="BrowseCases">العودة للحالات</a>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">
@model phase_1.BLL.DTOs.CreateOfferDTO

            <form class="health-panel form-panel" asp-controller="Offer" asp-action="CreateOffer" method="post">
                <input type="hidden" asp-for="CaseId" />
                <div class="panel-heading">
                    <div>
                        <h2>تفاصيل العرض</h2>
                        <p>حقول مختصرة تساعد المريض على فهم العرض بسرعة.</p>
                    </div>
                </div>

                <div asp-validation-summary="All" class="text-danger" style="color: red; padding: 10px; font-weight: bold;"></div>

                <div class="form-grid">
                    <label class="field-group">
                        <span>السعر المقترح</span>
                        <input class="form-control modern-input" asp-for="ProposedPrice" inputmode="decimal" placeholder="220" />
                    </label>
                    <label class="field-group">
                        <span>عدد الجلسات المتوقع</span>
                        <input class="form-control modern-input" asp-for="EstimatedSessionsCount" inputmode="numeric" placeholder="2" />
                    </label>
                    <label class="field-group field-span-2">
                        <span>رسالة للمريض</span>
                        <textarea class="form-control modern-input modern-textarea" asp-for="Message" rows="6" placeholder="اشرح خطتك المختصرة، سبب السعر، وما يحتاجه المريض قبل الجلسة."></textarea>
                    </label>
                </div>

                <div class="alert-soft-success">
                    هذا العرض سيتم تقديمه باسم الطالب الحالي. تأكد من دقة المعلومات.
                </div>

                <div class="form-actions">
                    <button type="submit" class="primary-action loading-button" style="border:none; cursor:pointer;">
                        <span class="button-label">إرسال العرض</span>
                    </button>
                    <a class="ghost-action" asp-controller="Offer" asp-action="BrowseCases">إلغاء</a>
                </div>
            </form>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>ملخص الحالة</h2>
                        <p>مرجع سريع أثناء كتابة العرض.</p>
                    </div>
                </div>
                <dl class="stacked-list">
                    <div>
                        <dt>العنوان</dt>
                        <dd>متابعة لطفل يعاني من تسوسات متعددة</dd>
                    </div>
                    <div>
                        <dt>الموقع</dt>
                        <dd>القاهرة، مدينة نصر</dd>
                    </div>
                    <div>
                        <dt>الميزانية</dt>
                        <dd>180 - 250 ج.م</dd>
                    </div>
                </dl>
            </article>
        </aside>
    </div>
</section>
