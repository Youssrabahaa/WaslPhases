@model phase_1.BLL.DTOs.CreateOfferDTO
@{
    ViewData["Title"] = "تقديم عرض";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">تقديم عرض</span>
            <h1 class="health-title">قدّم عرض واضح للمريض.</h1>
            <p class="health-subtitle">العرض الجيد يوضح السعر، عدد الجلسات، والخطة المختصرة قبل قبول المريض.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action"
               asp-controller="Offer"
               asp-action="BrowseCases"
               asp-route-portal="@portalRoute">العودة للحالات</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert-soft-danger">@TempData["Error"]</div>
    }

    <div class="content-grid">
        <section class="content-main">

            <form class="health-panel form-panel"
                  asp-action="CreateOffer"
                  asp-controller="Offer"
                  asp-route-portal="@portalRoute"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="CaseId" />
                <input type="hidden" asp-for="StudentUserId" />

                <div class="panel-heading">
                    <div>
                        <h2>تفاصيل العرض</h2>
                        <p>حقول مختصرة تساعد المريض على فهم العرض بسرعة.</p>
                    </div>
                </div>

                <div class="form-grid">
                    <label class="field-group">
                        <span>السعر المقترح (ج.م)</span>
                        <input class="form-control modern-input"
                               asp-for="ProposedPrice"
                               inputmode="decimal"
                               placeholder="220" />
                        <span asp-validation-for="ProposedPrice" class="text-danger"></span>
                    </label>

                    <label class="field-group">
                        <span>عدد الجلسات المتوقع</span>
                        <input class="form-control modern-input"
                               asp-for="EstimatedSessionsCount"
                               inputmode="numeric"
                               placeholder="2" />
                        <span asp-validation-for="EstimatedSessionsCount" class="text-danger"></span>
                    </label>

                    <label class="field-group field-span-2">
                        <span>رسالة للمريض</span>
                        <textarea class="form-control modern-input modern-textarea"
                                  asp-for="Message"
                                  rows="6"
                                  placeholder="اشرح خطتك المختصرة، سبب السعر، وما يحتاجه المريض قبل الجلسة."></textarea>
                    </label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="primary-action">إرسال العرض</button>
                    <a class="ghost-action"
                       asp-controller="Offer"
                       asp-action="BrowseCases"
                       asp-route-portal="@portalRoute">إلغاء</a>
                </div>
            </form>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>ملخص الحالة</h2>
                        <p>مرجع سريع أثناء كتابة العرض.</p>
                    </div>
                </div>
                <dl class="stacked-list">
                    <div>
                        <dt>رقم الحالة</dt>
                        <dd>#@Model.CaseId</dd>
                    </div>
                </dl>
            </article>
        </aside>
    </div>
</section>
