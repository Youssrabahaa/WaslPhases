@model IEnumerable<phase_1.BLL.DTOs.OfferDTO>
@{
    ViewData["Title"] = "عروضي";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">عروضي</span>
            <h1 class="health-title">تابع عروضك من أول إرسال لحد القبول.</h1>
            <p class="health-subtitle">قائمة عروضك — معلق، مقبول، مرفوض.</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action"
               asp-controller="Offer"
               asp-action="BrowseCases"
               asp-route-portal="@portalRoute">تصفح حالات جديدة</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="app-toast"><span class="app-toast-dot"></span>@TempData["Success"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="offer-list">
            @foreach (var offer in Model)
            {
                
                    var statusText  = offer.Status == 1 ? "قيد المراجعة"
                                    : offer.Status == 2 ? "مقبول"
                                    : offer.Status == 3 ? "مرفوض"
                                    : "ملغي";
                    var statusClass = offer.Status == 1 ? "status-pending"
                                    : offer.Status == 2 ? "status-open"
                                    : "status-rejected";
                
                <article class="offer-card">
                    <div>
                        <div class="offer-card-top">
                            <span class="status-badge @statusClass">@statusText</span>
                            <span class="case-meta">عرض رقم @offer.Id</span>
                        </div>
                        <h3>حالة رقم @offer.CaseId</h3>
                        <p class="case-meta">
                            @(offer.EstimatedSessionsCount?.ToString() ?? "—") جلسة —
                            @offer.CreatedAt.ToString("dd MMM yyyy")
                        </p>
                        <div class="row-actions mt-3">
                            <a class="ghost-action compact-action"
                               asp-controller="Offer"
                               asp-action="OfferDetails"
                               asp-route-id="@offer.Id"
                               asp-route-portal="@portalRoute">تفاصيل العرض</a>

                            @if (offer.Status == 2)
                            {
                                <a class="primary-action compact-action"
                                   asp-controller="Match"
                                   asp-action="Index"
                                   asp-route-portal="@portalRoute">تفاصيل المطابقة</a>
                            }
                        </div>
                    </div>
                    <div class="card-side">
                        <strong>@(offer.ProposedPrice?.ToString("N0") ?? "—") ج.م</strong>
                        <span class="case-meta">@(offer.EstimatedSessionsCount ?? 0) جلسة</span>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <section class="state-grid">
            <article class="empty-state-card">
                <span class="empty-state-icon">📋</span>
                <h3>لا توجد عروض</h3>
                <p>لم تقدم أي عروض بعد. ابدأ بتصفح الحالات المفتوحة.</p>
                <a class="ghost-action mt-3"
                   asp-controller="Offer"
                   asp-action="BrowseCases"
                   asp-route-portal="@portalRoute">تصفح الحالات</a>
            </article>
        </section>
    }
</section>
