@model IEnumerable<phase_1.BLL.DTOs.OfferDTO>
@{
    ViewData["Title"] = "عروضي";
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">My Offers</span>
            <h1 class="health-title">تابع عروضك من أول إرسال لحد القبول.</h1>
            <p class="health-subtitle">قائمة تعرض حالات العروض: معلق، مقبول، مرفوض، وتدعم حالة عدم وجود عروض.</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Offer" asp-action="BrowseCases">تصفح حالات جديدة</a>
        </div>
    </div>

    <div class="offer-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var offer in Model)
            {
                <article class="offer-card">
                    <div>
                        <div class="offer-card-top">
                            @if (offer.Status == 1)
                            {
                                <span class="status-badge status-pending">قيد المراجعة</span>
                            }
                            else if (offer.Status == 2)
                            {
                                <span class="status-badge status-open">مقبول</span>
                            }
                            else
                            {
                                <span class="status-badge" style="background-color:#e0e0e0;color:#555;">مرفوض</span>
                            }
                            <span class="case-meta">عرض رقم @offer.Id</span>
                        </div>
                        <h3>عرض للحالة رقم @offer.CaseId</h3>
                        <p>@offer.Message</p>
                        <div class="row-actions mt-3">
                            @if (offer.Status == 2)
                            {
                                <a class="primary-action compact-action" asp-controller="Match" asp-action="MatchDetails" asp-route-id="@offer.Id">تفاصيل المطابقة</a>
                            }
                            <a class="ghost-action compact-action" asp-controller="Offer" asp-action="OfferDetails" asp-route-id="@offer.Id">تفاصيل العرض</a>
                        </div>
                    </div>
                    <div class="card-side">
                        <strong>@offer.ProposedPrice ج.م</strong>
                        <span class="case-meta">@offer.EstimatedSessionsCount جلسات</span>
                    </div>
                </article>
            }
        }
        else
        {
            <article class="empty-state-card" style="grid-column: 1 / -1; text-align: center; padding: 40px;">
                <span class="empty-state-icon" style="font-size: 3rem; color: #ccc;">0</span>
                <h3>لا يوجد عروض</h3>
                <p>لم تقم بتقديم أي عروض حتى الآن.</p>
                <a class="ghost-action" asp-controller="Offer" asp-action="BrowseCases">تصفح الحالات</a>
            </article>
        }
    </div>

    <section class="state-grid">
        <article class="empty-state-card">
            <span class="empty-state-icon">0</span>
            <h3>No offers</h3>
            <p>لم تقدم أي عروض بعد. ابدأ بتصفح الحالات المفتوحة واختر حالة مناسبة لتخصصك.</p>
            <a class="ghost-action" asp-controller="Offer" asp-action="BrowseCases">تصفح الحالات</a>
        </article>
        @await Html.PartialAsync("_Loader")
        <article class="empty-state-card">
            <span class="empty-state-icon">!</span>
            <h3>خطأ في تحميل العروض</h3>
            <p>تظهر هذه الحالة عند تعذر جلب العروض من الخادم.</p>
        </article>
    </section>
</section>
