@model List<phase_1.BLL.DTOs.OfferDTO>
@{
    ViewData["Title"] = "عروض الحالة";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString() ?? "patient";
    var caseId = ViewBag.CaseId ?? 0;
    var caseTitle = ViewBag.CaseTitle as string ?? "الحالة";
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">عروض الحالة</span>
            <h1 class="health-title">@caseTitle</h1>
            <p class="health-subtitle">راجع عروض الطلاب، واقبل عرضا واحدا لإنشاء المطابقة والمحادثة.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action" asp-controller="Case" asp-action="CaseDetails" asp-route-id="@caseId" asp-route-portal="@portalRoute">تفاصيل الحالة</a>
            <a class="ghost-action" asp-controller="Case" asp-action="MyCases" asp-route-portal="@portalRoute">حالاتي</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="app-toast"><span class="app-toast-dot"></span>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-soft-danger">@TempData["Error"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="offer-list">
            @foreach (var offer in Model)
            {
                var statusText = offer.Status == 1 ? "قيد المراجعة" : offer.Status == 2 ? "مقبول" : "مرفوض";
                var statusClass = offer.Status == 1 ? "status-pending" : offer.Status == 2 ? "status-open" : "status-rejected";
                <article class="session-card">
                    <div>
                        <div class="case-card-top">
                            <span class="status-badge @statusClass">@statusText</span>
                            <span class="case-meta">@(offer.StudentName ?? $"طالب رقم {offer.StudentUserId}")</span>
                        </div>
                        <h3>@(offer.ProposedPrice?.ToString("N0") ?? "-") ج.م</h3>
                        <p>@(string.IsNullOrWhiteSpace(offer.Message) ? "لا توجد رسالة مرفقة." : offer.Message)</p>
                        <div class="row-actions mt-3">
                            <a class="ghost-action compact-action"
                               asp-controller="Offer"
                               asp-action="OfferDetails"
                               asp-route-id="@offer.Id"
                               asp-route-portal="@portalRoute">تفاصيل العرض</a>

                            @if (offer.Status == 1)
                            {
                                <form asp-controller="Offer" asp-action="AcceptOffer" asp-route-portal="@portalRoute" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="offerId" value="@offer.Id" />
                                    <input type="hidden" name="caseId" value="@offer.CaseId" />
                                    <button type="submit" class="primary-action compact-action">قبول</button>
                                </form>
                                <form asp-controller="Offer" asp-action="RejectOffer" asp-route-portal="@portalRoute" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@offer.Id" />
                                    <button type="submit" class="danger-action compact-action">رفض</button>
                                </form>
                            }
                        </div>
                    </div>
                    <div class="card-side">
                        <strong>@(offer.EstimatedSessionsCount?.ToString() ?? "-") جلسات</strong>
                        <span class="case-meta">@offer.CreatedAt.ToString("dd MMM yyyy")</span>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <section class="state-grid">
            <article class="empty-state-card">
                <span class="empty-state-icon">0</span>
                <h3>لا توجد عروض بعد</h3>
                <p>عند تقديم الطلاب لعروض على هذه الحالة ستظهر هنا.</p>
            </article>
        </section>
    }
</section>
