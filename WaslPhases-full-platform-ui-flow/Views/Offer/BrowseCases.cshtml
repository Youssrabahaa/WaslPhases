@model List<phase_1.BLL.DTOs.CaseListDTO>
@{
    ViewData["Title"] = "تصفح الحالات";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">تصفح الحالات</span>
            <h1 class="health-title">حالات مناسبة لتدريبك، مرتبة بذكاء.</h1>
            <p class="health-subtitle">تصفح الحالات المتاحة وقدم عرضك على ما يناسب تخصصك.</p>
        </div>
        <div class="hero-actions">
            <a class="ghost-action" asp-controller="Offer" asp-action="MyOffers" asp-route-portal="@portalRoute">عروضي</a>
        </div>
    </div>

    <div class="content-grid">
        <section class="content-main">

            @if (Model != null && Model.Any())
            {
                @foreach (var c in Model)
                {
                    <article class="case-card">
                        <div>
                            <div class="case-card-top">
                                <span class="status-badge status-open">متاحة</span>
                                <span class="case-meta">@c.TreatmentCategoryName</span>
                                <span class="case-meta">@c.City</span>
                            </div>
                            <h3>@c.Title</h3>
                            <p class="case-meta">@c.Governorate — @c.OffersCount عرض حتى الآن</p>
                            <div class="row-actions mt-3">
                                <a class="primary-action compact-action"
                                   asp-controller="Offer"
                                   asp-action="CreateOffer"
                                   asp-route-caseId="@c.Id"
                                   asp-route-portal="@portalRoute">تقديم عرض</a>
                                <a class="ghost-action compact-action"
                                   asp-controller="Case"
                                   asp-action="CaseDetails"
                                   asp-route-id="@c.Id"
                                   asp-route-portal="@portalRoute">تفاصيل الحالة</a>
                            </div>
                        </div>
                        <div class="card-side">
                            <strong>
                                @(c.EstimatedPriceMin.HasValue ? $"{c.EstimatedPriceMin:N0}" : "—") —
                                @(c.EstimatedPriceMax.HasValue ? $"{c.EstimatedPriceMax:N0}" : "—") ج.م
                            </strong>
                            <span class="case-meta">@c.ServiceTypeName</span>
                            <span class="case-meta">@c.CreatedAt.ToString("dd MMM yyyy")</span>
                        </div>
                    </article>
                }
            }
            else
            {
                <section class="state-grid">
                    <article class="empty-state-card">
                        <span class="empty-state-icon">📋</span>
                        <h3>لا توجد حالات متاحة</h3>
                        <p>لا توجد حالات مفتوحة حالياً. تحقق لاحقاً.</p>
                    </article>
                </section>
            }

        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>فلترة</h2>
                        <p>يمكن ربطها لاحقاً بمعاملات البحث.</p>
                    </div>
                </div>
                <div class="form-panel">
                    <label class="field-group">
                        <span>المحافظة</span>
                        <select class="form-select modern-input">
                            <option>الكل</option>
                            <option>القاهرة</option>
                            <option>الجيزة</option>
                            <option>الإسكندرية</option>
                        </select>
                    </label>
                    <label class="field-group">
                        <span>نوع الخدمة</span>
                        <select class="form-select modern-input">
                            <option>كل الخدمات</option>
                            <option>داخل العيادة</option>
                            <option>زيارة منزلية</option>
                        </select>
                    </label>
                </div>
            </article>
        </aside>
    </div>
</section>
