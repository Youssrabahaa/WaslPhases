@model phase_1.DTOs.ProfileDTO

@{
    ViewData["Title"] = "ملف الطالب";
    var student = Model.StudentProfile;
    var email = string.IsNullOrWhiteSpace(Model.Email) ? "غير مضاف" : Model.Email;
    var faculty = string.IsNullOrWhiteSpace(student?.FacultyName) ? $"كلية رقم {student?.FacultyId}" : student!.FacultyName;
    var studentCode = string.IsNullOrWhiteSpace(student?.StudentCode) ? "غير مضاف" : student!.StudentCode;
    var supervisor = string.IsNullOrWhiteSpace(student?.SupervisorName) ? "غير مضاف" : student!.SupervisorName;
    var clinic = string.IsNullOrWhiteSpace(student?.ClinicName) ? "غير مضاف" : student!.ClinicName;
    var requiredCases = student?.RequiredCasesCount ?? 0;
    var completedCases = student?.CompletedCasesCount ?? 0;
    var progress = requiredCases == 0 ? 0 : Math.Min(100, (int)Math.Round((completedCases * 100.0) / requiredCases));
    var verifiedText = student?.IsVerified == true ? "موثق" : "بانتظار التوثيق";
    var phoneVerifiedText = Model.IsPhoneVerified ? "تم تأكيد رقم الهاتف" : "بانتظار تأكيد رقم الهاتف";
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">بوابة الطالب</span>
            <h1 class="health-title">@Model.FullName</h1>
            <p class="health-subtitle">دي بيانات حسابك وملفك الأكاديمي المسجلة في النظام بعد إنشاء الحساب وتسجيل الدخول.</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Offer" asp-action="BrowseCases">تصفح الحالات</a>
            <a class="ghost-action" asp-controller="Student" asp-action="EditProfile">تعديل الملف</a>
        </div>
    </div>

    <div class="metric-strip">
        <article class="mini-kpi">
            <span class="mini-kpi-label">الحالات المطلوبة</span>
            <strong>@requiredCases</strong>
            <span class="mini-kpi-meta">حسب بيانات التسجيل</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">الحالات المكتملة</span>
            <strong>@completedCases</strong>
            <span class="mini-kpi-meta">@progress% من المطلوب</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">حالة التوثيق</span>
            <strong>@verifiedText</strong>
            <span class="mini-kpi-meta">@phoneVerifiedText</span>
        </article>
    </div>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>بيانات الحساب</h2>
                        <p>هذه البيانات مأخوذة من الحساب الذي سجلت به.</p>
                    </div>
                    <span class="status-badge @(student?.IsVerified == true ? "status-open" : "status-pending")">@verifiedText</span>
                </div>

                <div class="info-grid">
                    <div class="info-block">
                        <span>الاسم بالكامل</span>
                        <strong>@Model.FullName</strong>
                    </div>
                    <div class="info-block">
                        <span>رقم الهاتف</span>
                        <strong>@Model.Phone</strong>
                    </div>
                    <div class="info-block">
                        <span>البريد الإلكتروني</span>
                        <strong>@email</strong>
                    </div>
                    <div class="info-block">
                        <span>حالة الهاتف</span>
                        <strong>@phoneVerifiedText</strong>
                    </div>
                </div>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>بيانات الطالب</h2>
                        <p>بيانات الكلية والعيادة والمشرف المحفوظة في ملف الطالب.</p>
                    </div>
                </div>

                <div class="info-grid">
                    <div class="info-block">
                        <span>كود الطالب</span>
                        <strong>@studentCode</strong>
                    </div>
                    <div class="info-block">
                        <span>الكلية</span>
                        <strong>@faculty</strong>
                    </div>
                    <div class="info-block">
                        <span>السنة الدراسية</span>
                        <strong>@(student?.AcademicYear.ToString() ?? "غير مضاف")</strong>
                    </div>
                    <div class="info-block">
                        <span>اسم المشرف</span>
                        <strong>@supervisor</strong>
                    </div>
                    <div class="info-block">
                        <span>اسم العيادة</span>
                        <strong>@clinic</strong>
                    </div>
                    <div class="info-block">
                        <span>تاريخ إنشاء الحساب</span>
                        <strong>@Model.CreatedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))</strong>
                    </div>
                </div>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>تقدم الحالات</h2>
                        <p>متابعة سريعة لعدد الحالات المطلوبة والمكتملة.</p>
                    </div>
                    <strong>@completedCases / @requiredCases</strong>
                </div>
                <div class="progress-soft" aria-label="نسبة التقدم">
                    <span style="width: @progress%"></span>
                </div>
            </article>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>اختصارات الطالب</h2>
                        <p>إجراءات مرتبطة بحسابك الحالي.</p>
                    </div>
                </div>
                <div class="action-list">
                    <a class="action-tile" asp-controller="Offer" asp-action="BrowseCases">
                        <strong>تصفح الحالات</strong>
                        <span>اعرض الحالات المتاحة حسب النوع والموقع.</span>
                    </a>
                    <a class="action-tile" asp-controller="Offer" asp-action="MyOffers">
                        <strong>متابعة العروض</strong>
                        <span>راجع العروض المقبولة والمعلقة والمرفوضة.</span>
                    </a>
                </div>
            </article>
        </aside>
    </div>
</section>
