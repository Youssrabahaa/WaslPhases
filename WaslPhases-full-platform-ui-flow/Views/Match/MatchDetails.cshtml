@model phase_1.BLL.DTOs.MatchDetailsDTO
@{
    ViewData["Title"] = "تفاصيل المطابقة";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();

    var statusClass = Model.Status == 1 ? "status-inprogress"
                    : Model.Status == 2 ? "status-completed"
                    : "status-rejected";
    var statusText = Model.Status == 1 ? "نشطة"
                    : Model.Status == 2 ? "مكتملة"
                    : "ملغية";
}

<section class="health-page">
    <a class="action-tile"
       asp-controller="Conversation"
       asp-action="Chat"
       asp-route-matchId="@Model.MatchId"
       asp-route-portal="@portalRoute">
        <strong>💬 المحادثة</strong>
        <span>تواصل مع الطرف الآخر.</span>
    </a>
    <!-- Hero-->
    <div class="health-hero">
        <div>
            <span class="health-kicker">من العرض إلى المطابقة</span>
            <h1 class="health-title">مطابقة رقم @Model.MatchId</h1>
            <p class="health-subtitle">@Model.CaseTitle — تفاصيل المريض والطالب والجلسات والعرض المقبول.</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action"
               asp-controller="Session"
               asp-action="SessionList"
               asp-route-matchId="@Model.MatchId"
               asp-route-portal="@portalRoute">
                إدارة الجلسات
            </a>
            <a class="ghost-action"
               asp-controller="Session"
               asp-action="SessionList"
               asp-route-matchId="@Model.MatchId"
               asp-route-portal="@portalRoute">
                التقارير من الجلسات
            </a>

            @if (Model.Status == 1)
            {
                <form asp-action="Cancel"
                      asp-controller="Match"
                      asp-route-portal="@portalRoute"
                      method="post"
                      style="display:inline;"
                      onsubmit="return confirm('هل أنت متأكد من إلغاء المطابقة؟ سيُعاد فتح الحالة للعروض.')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.MatchId" />
                    <input type="hidden" name="dto.UserId" value="0" />
                    <button type="submit" class="danger-action">إلغاء المطابقة</button>
                </form>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="app-toast"><span class="app-toast-dot"></span>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-soft-danger">@TempData["Error"]</div>
    }

   
    <div class="metric-strip">
        <article class="mini-kpi">
            <span class="mini-kpi-label">حالة المطابقة</span>
            <strong><span class="status-badge @statusClass">@statusText</span></strong>
            <span class="mini-kpi-meta">
                @(Model.AcceptedAt.HasValue ? $"قُبل {Model.AcceptedAt.Value:dd MMM yyyy}" : "")
            </span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">الجلسات</span>
            <strong>@Model.CompletedSessions / @(Model.SessionsCount ?? 0)</strong>
            <span class="mini-kpi-meta">@Model.RemainingSessions جلسة متبقية</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">السعر المتفق</span>
            <strong>@(Model.AgreedPrice?.ToString("N0") ?? "—") ج.م</strong>
            <span class="mini-kpi-meta">@(Model.SessionsCount ?? 0) جلسة</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">التصنيف</span>
            <strong>@Model.TreatmentCategory</strong>
            <span class="mini-kpi-meta">@Model.Governorate — @Model.City</span>
        </article>
    </div>

    <div class="content-grid">
        <section class="content-main">

      
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>أطراف المطابقة</h2>
                        <p>ملخص واضح للمريض، الطالب، الحالة، والعرض المقبول.</p>
                    </div>
                    <span class="status-badge @statusClass">@statusText</span>
                </div>
                <div class="info-grid">
                    <div class="info-block">
                        <span>المريض</span>
                        <strong>@Model.PatientName</strong>
                        <small class="case-meta">@Model.PatientPhone</small>
                    </div>
                    <div class="info-block">
                        <span>الطالب</span>
                        <strong>@Model.StudentName</strong>
                        <small class="case-meta">@Model.StudentPhone</small>
                    </div>
                    <div class="info-block">
                        <span>الحالة الطبية</span>
                        <strong>@Model.CaseTitle</strong>
                    </div>
                    <div class="info-block">
                        <span>الموقع</span>
                        <strong>@Model.Governorate — @Model.City — @Model.Area</strong>
                    </div>
                    <div class="info-block">
                        <span>العرض المقبول</span>
                        <strong>@(Model.AgreedPrice?.ToString("N0") ?? "—") ج.م / @(Model.SessionsCount ?? 0) جلسة</strong>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CaseDescription))
                    {
                        <div class="info-block">
                            <span>وصف الحالة</span>
                            <strong>@Model.CaseDescription</strong>
                        </div>
                    }
                </div>
            </article>


            @if (!string.IsNullOrEmpty(Model.OfferMessage))
            {
                <article class="health-panel">
                    <div class="panel-heading">
                        <div>
                            <h2>رسالة العرض</h2>
                            <p>ما كتبه الطالب عند تقديم عرضه.</p>
                        </div>
                    </div>
                    <p class="body-copy">@Model.OfferMessage</p>
                </article>
            }

        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>إجراءات سريعة</h2>
                        <p>أهم العمليات المرتبطة بالمطابقة.</p>
                    </div>
                </div>
                <div class="action-list">
                    <a class="action-tile"
                       asp-controller="Session"
                       asp-action="SessionList"
                       asp-route-matchId="@Model.MatchId"
                       asp-route-portal="@portalRoute">
                        <strong>📅 فتح الجلسات</strong>
                        <span>راجع قائمة الجلسات المرتبطة بهذه المطابقة.</span>
                    </a>
                    <a class="action-tile"
                       asp-controller="Review"
                       asp-action="AddReview"
                       asp-route-matchId="@Model.MatchId"
                       asp-route-portal="@portalRoute">
                        <strong>⭐ إضافة تقييم</strong>
                        <span>بعد اكتمال الجلسات يمكن تسجيل تقييم.</span>
                    </a>
                </div>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>ملخص العرض</h2>
                        <p>بيانات سريعة عن الاتفاق الحالي.</p>
                    </div>
                </div>
                <div class="summary-strip">
                    <div class="summary-tile">
                        <span>الفئة</span>
                        <strong>@Model.TreatmentCategory</strong>
                    </div>
                    <div class="summary-tile">
                        <span>الموقع</span>
                        <strong>@Model.Governorate - @Model.City - @Model.Area</strong>
                    </div>
                    <div class="summary-tile">
                        <span>السعر</span>
                        <strong>@(Model.AgreedPrice?.ToString("N0") ?? "—") ج.م</strong>
                    </div>
                    <div class="summary-tile">
                        <span>الجلسات</span>
                        <strong>@(Model.SessionsCount ?? 0)</strong>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.OfferMessage))
                {
                    <div class="info-block mt-4">
                        <span>رسالة العرض</span>
                        <p>@Model.OfferMessage</p>
                    </div>
                }

                <div class="form-actions mt-4">
                    <a class="primary-action"
                       asp-controller="Session"
                       asp-action="SessionList"
                       asp-route-matchId="@Model.MatchId"
                       asp-route-portal="@portalRoute">عرض الجلسات</a>
                    <a class="ghost-action"
                       asp-controller="Offer"
                       asp-action="OfferDetails"
                       asp-route-id="@Model.OfferId"
                       asp-route-portal="@portalRoute">تفاصيل العرض</a>
                </div>
            </article>
        </aside>
    </div>
</section>
