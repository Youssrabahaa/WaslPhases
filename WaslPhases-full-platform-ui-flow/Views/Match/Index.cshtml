@model IEnumerable<phase_1.BLL.DTOs.MatchDTO>
@{
    ViewData["Title"] = "المطابقات";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString();
    var userRole = Context.Session.GetInt32("UserRole") ?? 0;
    var isPatient = userRole == 1;
    var isStudent = userRole == 2;
}

<section class="health-page">
    <div class="health-hero compact-hero">
        <div>
            <span class="health-kicker">@(isPatient ? "بوابة المريض" : "بوابة الطالب")</span>
            <h1 class="health-title">كل المطابقات المرتبطة بحسابك</h1>
            <p class="health-subtitle">افتح تفاصيل المطابقة لإدارة الجلسات والتواصل والتقارير.</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="offer-list">
            @foreach (var match in Model)
            {
                var sClass = match.Status == 1 ? "status-inprogress"
                               : match.Status == 2 ? "status-completed"
                               : "status-rejected";
                var sText = match.Status == 1 ? "نشطة"
                               : match.Status == 2 ? "مكتملة"
                               : "ملغية";
                <article class="session-card">
                    <div>
                        <div class="case-card-top">
                            <span class="status-badge @sClass">@sText</span>
                            <span class="case-meta">مطابقة رقم @match.MatchId</span>
                        </div>
                        <h3>@match.CaseTitle</h3>
                        <p>@(match.AcceptedAt.HasValue ? $"تم القبول {match.AcceptedAt.Value:dd/MM/yyyy}" : "مطابقة قيد المتابعة")</p>
                        <div class="row-actions mt-3">
                            <a class="primary-action compact-action"
                               asp-controller="Match"
                               asp-action="MatchDetails"
                               asp-route-id="@match.MatchId"
                               asp-route-portal="@portalRoute">تفاصيل المطابقة</a>
                            <a class="ghost-action compact-action"
                               asp-controller="Session"
                               asp-action="SessionList"
                               asp-route-matchId="@match.MatchId"
                               asp-route-portal="@portalRoute">الجلسات</a>
                            @* ✅ الشات: متاح مباشرة من قائمة المطابقات *@
                            @if (match.Status == 1)
                            {
                                <a class="ghost-action compact-action"
                                   asp-controller="Conversation"
                                   asp-action="Chat"
                                   asp-route-matchId="@match.MatchId"
                                   asp-route-portal="@portalRoute"
                                   style="background: linear-gradient(135deg, var(--teal), var(--blue)); color: white; border: none;">
                                    💬 شات
                                </a>
                            }
                        </div>
                    </div>
                    <div class="card-side">
                        <strong><span class="status-badge @sClass">@sText</span></strong>
                        <span class="case-meta">
                            @(match.AcceptedAt.HasValue ? match.AcceptedAt.Value.ToString("dd/MM/yyyy") : "—")
                        </span>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <section class="state-grid">
            <article class="empty-state-card">
                <span class="empty-state-icon">🤝</span>
                <h3>لا توجد مطابقات</h3>
                @if (isPatient)
                {
                    <p>عند قبول عرض من أحد الطلاب ستظهر المطابقة هنا.</p>
                    <div class="mt-3">
                        <a class="primary-action" asp-controller="Case" asp-action="MyCases" asp-route-portal="@portalRoute">عرض حالاتي</a>
                    </div>
                }
                else
                {
                    <p>عندما يقبل المريض عرضك ستظهر المطابقة هنا.</p>
                    <div class="mt-3">
                        <a class="primary-action" asp-controller="Offer" asp-action="MyOffers" asp-route-portal="@portalRoute">عرض عروضي</a>
                    </div>
                }
            </article>
        </section>
    }
</section>
