@{
    ViewData["Title"] = "الرئيسية";
    var portalRoute = ViewContext.RouteData.Values["portal"]?.ToString() ?? "student";
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">منصة مطابقة الرعاية الصحية</span>
            <h1 class="health-title">وصل ينظم الرحلة من الحالة للعرض للجلسة.</h1>
            <p class="health-subtitle">لوحة موحدة تجمع التسجيل، الطالب، العروض، المطابقات، الجلسات، التقارير، والتقييمات في تجربة واحدة متماسكة.</p>
        </div>
        <div class="hero-actions">
            <a class="primary-action" asp-controller="Auth" asp-action="Login">ابدأ من تسجيل الدخول</a>
            <a class="ghost-action" asp-controller="Offer" asp-action="BrowseCases">تصفح الحالات</a>
        </div>
    </div>

    <div class="metric-strip">
        <article class="mini-kpi">
            <span class="mini-kpi-label">الأقسام</span>
            <strong>5</strong>
            <span class="mini-kpi-meta">التسجيل، الطالب، الأساسيات، الواجهة</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">الصفحات</span>
            <strong>20+</strong>
            <span class="mini-kpi-meta">جاهزة للربط</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">الحالات</span>
            <strong>فارغ / تحميل / خطأ</strong>
            <span class="mini-kpi-meta">موجودة في الصفحات</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">متجاوبة</span>
            <strong>نعم</strong>
            <span class="mini-kpi-meta">حاسوب وهاتف</span>
        </article>
    </div>

    <section class="module-grid">
        <a class="module-card" asp-controller="Auth" asp-action="Login">
            <span class="module-icon">ت</span>
            <h2>التسجيل والدخول</h2>
            <p>تسجيل الدخول، إنشاء الحساب، رمز التحقق، واستعادة كلمة المرور.</p>
        </a>
        <a class="module-card" asp-controller="Student" asp-action="Profile">
            <span class="module-icon">ط</span>
            <h2>مسار الطالب</h2>
            <p>الملف الشخصي، تعديل البيانات، تصفح الحالات، إنشاء عرض، ومتابعة العروض.</p>
        </a>
        <a class="module-card" asp-controller="Match" asp-action="MatchDetails" asp-route-id="1" asp-route-portal="@portalRoute">
            <span class="module-icon">م</span>
            <h2>المطابقة والمتابعة</h2>
            <p>تحويل العرض إلى مطابقة، متابعة الجلسات، التقارير، وخطوات المتابعة.</p>
        </a>
        <!-- إضافة رابط مباشر للجلسات مع matchId تجريبي -->
        <a class="module-card" asp-controller="Session" asp-action="SessionList" asp-route-matchId="1" asp-route-portal="@portalRoute" style="border-color: #10b981;">
            <span class="module-icon">ج</span>
            <h2>الجلسات</h2>
            <p>عرض وإدارة جلسات العلاج للمطابقات النشطة.</p>
        </a>
    </section>

    <div class="content-grid">
        <section class="content-main">
            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>مكونات قابلة لإعادة الاستخدام</h2>
                        <p>أمثلة فعلية للأجزاء المشتركة المطلوبة.</p>
                    </div>
                    <button class="ghost-action compact-action" data-bs-toggle="modal" data-bs-target="#sharedModal">فتح النافذة</button>
                </div>
                <div class="state-grid">
                    @await Html.PartialAsync("_Card")
                    @await Html.PartialAsync("_EmptyState")
                    @await Html.PartialAsync("_Loader")
                </div>
            </article>

            <article class="health-panel">
                <div class="panel-heading">
                    <div>
                        <h2>نموذج موحد</h2>
                        <p>جزء جاهز لإعادة الاستخدام داخل أي شاشة.</p>
                    </div>
                </div>
                @await Html.PartialAsync("_Form")
            </article>
        </section>

        <aside class="content-side">
            <article class="health-panel side-accent">
                <div class="panel-heading">
                    <div>
                        <h2>آخر الإشعارات</h2>
                        <p>مكون موحد للإشعار.</p>
                    </div>
                    <a class="text-link" asp-controller="Notification" asp-action="GetNotifications">الكل</a>
                </div>
                <div class="notification-list">
                    @await Html.PartialAsync("_NotificationItem")
                    <article class="notification-item">
                        <span class="notification-glow"></span>
                        <div>
                            <strong>جلسة قادمة</strong>
                            <p>تم تأكيد موعد الجلسة التالية في الخامسة مساء.</p>
                        </div>
                        <time>اليوم</time>
                    </article>
                </div>
            </article>
        </aside>
    </div>
</section>

@await Html.PartialAsync("_Modal")