@{
    ViewData["Title"] = "الرئيسية";
    var sessionRole = Context.Session.GetInt32("UserRole");
    var portalRoute = sessionRole == 1 ? "patient"
        : sessionRole == 2 ? "student"
        : ViewContext.RouteData.Values["portal"]?.ToString() ?? "student";
    var isPatient = sessionRole == 1;
    var isStudent = sessionRole == 2;
    var userName = Context.Session.GetString("UserName") ?? "";
}

<section class="health-page">
    <div class="health-hero">
        <div>
            <span class="health-kicker">منصة مطابقة الرعاية الصحية</span>
            <h1 class="health-title">
                @if (!string.IsNullOrEmpty(userName))
                {
                    <span>مرحباً، @userName 👋</span>
                }
                else
                {
                    <span>وصل ينظم الرحلة من الحالة للعرض للجلسة.</span>
                }
            </h1>
            <p class="health-subtitle">لوحة موحدة تجمع التسجيل، الطالب، العروض، المطابقات، الجلسات، التقارير، والتقييمات في تجربة واحدة متماسكة.</p>
        </div>
        <div class="hero-actions">
            @if (isPatient)
            {
                <a class="primary-action" asp-controller="Case" asp-action="MyCases" asp-route-portal="@portalRoute">حالاتي</a>
                <a class="ghost-action" asp-controller="Session" asp-action="SessionList" asp-route-portal="@portalRoute">جلساتي</a>
            }
            else if (isStudent)
            {
                <a class="primary-action" asp-controller="Offer" asp-action="BrowseCases" asp-route-portal="@portalRoute">تصفح الحالات</a>
                <a class="ghost-action" asp-controller="Offer" asp-action="MyOffers" asp-route-portal="@portalRoute">عروضي</a>
            }
            else
            {
                <a class="primary-action" asp-controller="Auth" asp-action="Login">تسجيل الدخول</a>
                <a class="ghost-action" asp-controller="Auth" asp-action="Register">إنشاء حساب</a>
            }
        </div>
    </div>

    <div class="metric-strip">
        <article class="mini-kpi">
            <span class="mini-kpi-label">الأقسام</span>
            <strong>5</strong>
            <span class="mini-kpi-meta">التسجيل، الطالب، الأساسيات، الواجهة</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">الصفحات</span>
            <strong>20+</strong>
            <span class="mini-kpi-meta">جاهزة للربط</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">الحالات</span>
            <strong>فارغ / تحميل / خطأ</strong>
            <span class="mini-kpi-meta">موجودة في الصفحات</span>
        </article>
        <article class="mini-kpi">
            <span class="mini-kpi-label">متجاوبة</span>
            <strong>نعم</strong>
            <span class="mini-kpi-meta">حاسوب وهاتف</span>
        </article>
    </div>

    <section class="module-grid">
        @if (!isPatient && !isStudent)
        {
            <a class="module-card" asp-controller="Auth" asp-action="Login">
                <span class="module-icon">د</span>
                <h2>تسجيل الدخول</h2>
                <p>ادخل لحسابك لاستخدام المسار المناسب للدور.</p>
            </a>
        }
        @if (isPatient)
        {
            <a class="module-card" asp-controller="Patients" asp-action="Profile" asp-route-portal="@portalRoute">
                <span class="module-icon">م</span>
                <h2>ملف المريض</h2>
                <p>بيانات الحساب وحالاتك ومتابعة المطابقات والجلسات.</p>
            </a>
            <a class="module-card" asp-controller="Case" asp-action="MyCases" asp-route-portal="@portalRoute">
                <span class="module-icon">ح</span>
                <h2>حالاتي</h2>
                <p>إدارة الحالات الطبية ومتابعة العروض المقبولة عليها.</p>
            </a>
            <a class="module-card" asp-controller="Match" asp-action="Index" asp-route-portal="@portalRoute">
                <span class="module-icon">ط</span>
                <h2>المطابقات</h2>
                <p>تابع المطابقات مع الطلاب وأدر جلساتك.</p>
            </a>
        }
        @if (isStudent)
        {
            <a class="module-card" asp-controller="Student" asp-action="Profile" asp-route-portal="@portalRoute">
                <span class="module-icon">ط</span>
                <h2>مسار الطالب</h2>
                <p>الملف الشخصي، تصفح الحالات، إنشاء عرض، ومتابعة العروض.</p>
            </a>
            <a class="module-card" asp-controller="Offer" asp-action="BrowseCases" asp-route-portal="@portalRoute">
                <span class="module-icon">ح</span>
                <h2>تصفح الحالات</h2>
                <p>اعثر على حالات مناسبة وقدم عرضك الطبي.</p>
            </a>
            <a class="module-card" asp-controller="Match" asp-action="Index" asp-route-portal="@portalRoute">
                <span class="module-icon">م</span>
                <h2>المطابقات والمتابعة</h2>
                <p>تحويل العرض إلى مطابقة، متابعة الجلسات، التقارير، وخطوات المتابعة.</p>
            </a>
        }
        <a class="module-card" asp-controller="Session" asp-action="SessionList" asp-route-portal="@portalRoute" style="border-color: #10b981;">
            <span class="module-icon">ج</span>
            <h2>الجلسات</h2>
            <p>عرض وإدارة جلسات العلاج للمطابقات النشطة.</p>
        </a>
    </section>
</section>
